---
import Icon from './Icon.astro';
import { formatDate, strings } from '../i18n';
import { slideCountLabel } from '../lib/cards';
import type { PostSummary } from '../lib/cms-types';
import type { Locale } from '../lib/locale';

interface Props { locale: Locale; posts: PostSummary[]; headingLevel?: 2 | 3 }
const { locale, posts, headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}`;
const t = strings(locale);
---
<ul class="news-list">
  {posts.map((p) => (
    <li class="news-item">
      <time datetime={p.published_at}>{formatDate(p.published_at, locale)}</time>
      <H><a href={`/${locale}/news/${encodeURIComponent(p.slug)}/`}>{p.title}</a></H>
      {p.kind === 'cards' && (p.slide_count ?? 0) > 0 && (
        <p class="news-cards"><Icon name="cards" />{slideCountLabel(t.cards, p.slide_count ?? 0)}</p>
      )}
      {p.excerpt && <p>{p.excerpt}</p>}
    </li>
  ))}
</ul>
