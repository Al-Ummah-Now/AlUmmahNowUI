---
/**
 * A card post: slides read one at a time, each an image with its text drawn on it (docs/CMS_PUBLIC_API.md
 * "Card posts"). Server-rendered and usable without JS: Next, Back and the dots are links to
 * `?slide=N`, which this component honours. src/scripts/cards.ts turns them into instant navigation,
 * adds arrow keys (RTL-aware), swipe, `#N` deep links and the enlarged view.
 *
 * Every slide is in the HTML (real, selectable text; search engines read them all); only the current
 * one is shown. Each frame keeps a fixed 4:5 box, so changing slides never moves the page.
 */
import Icon from './Icon.astro';
import { fmt, strings } from '../i18n';
import { cardFit, cardFrame, neighbours, slideCountLabel } from '../lib/cards';
import type { Slide } from '../lib/cms-types';
import { dir, type Locale } from '../lib/locale';
import { pictureHtml } from '../lib/picture';

type CardSlide = Pick<Slide, 'image' | 'heading' | 'body' | 'position'>;
/**
 * `inline`: the viewer inside a list (the Articles list, the home timeline). There it is a strip of
 * every slide the list carries, one 4:5 frame wide, scrolled with CSS scroll-snap: swipe and
 * scrolling work natively and without JS (the strip is a focusable scroll region), and the strip
 * flows in the page's direction, so in Arabic the next card is to the left. src/scripts/cards.ts
 * adds Next/Back buttons, arrow keys, Home/End and the "Card 3 of 8" live text. `more` > 0 (the
 * list carries at most 10 cards) ends the strip with a "See all N cards" frame linking to the post.
 * On the home timeline (`size: 'timeline'`) the strip is the whole post: the `overlay` slot (title,
 * author, time) and the pager (small side arrows, position, thin segments) are drawn over the cards.
 */
interface Inline { href: string; uid: string; total: number; more: number; priority: boolean; size: 'list' | 'timeline' }
interface Props { slides: CardSlide[]; title: string; contentLocale: Locale; locale: Locale; initial?: number; pathname?: string; cmsOrigin: string; inline?: Inline }
const { slides, title, contentLocale, locale, initial = 0, pathname = '', cmsOrigin, inline } = Astro.props;
const t = strings(locale).cards;
const total = slides.length;
// One frame for the whole post (4:5, or square for square cards); an image of another shape shows whole.
const frame = cardFrame(slides);
const imgClass = (s: CardSlide) => (cardFit(s.image, frame) === 'contain' ? 'cv-img cv-contain' : 'cv-img');
const INLINE_SIZES = { list: '(min-width: 44rem) 26rem, calc(100vw - 2rem)', timeline: '(min-width: 44rem) 34rem, calc(100vw - 2rem)' };
const inlinePic = (s: CardSlide, i: number) =>
  pictureHtml(s.image, cmsOrigin, { sizes: INLINE_SIZES[inline?.size ?? 'list'], priority: !!inline?.priority && i === 0, className: imgClass(s) });
const shown = inline ? inline.total : total;
// The home timeline shows the cards alone: title, pager and position sit over them (shown on hover,
// focus or a tap), from the `overlay` slot and the controls below; a list page keeps its count line.
const bare = inline?.size === 'timeline';
const frames = inline ? slides.length + (inline.more > 0 ? 1 : 0) : 0;
const near = new Set([initial, ...neighbours(initial, total)]);
const SLIDE_SIZES = '(min-width: 44rem) 36rem, calc(100vw - 2rem)';
const pic = (s: CardSlide, i: number) => {
  const html = pictureHtml(s.image, cmsOrigin, { sizes: SLIDE_SIZES, priority: i === initial, className: imgClass(s) });
  // The neighbours load now (eager) so Next shows at once; the rest load when reached.
  return near.has(i) && i !== initial ? html.replace('loading="lazy"', 'loading="eager"') : html;
};
const href = (i: number) => (i <= 0 ? pathname : `${pathname}?slide=${i + 1}`);
const showDots = total > 1 && total <= 16;
---
{inline ? (
<section
  class:list={['cards-inline', `ci-${inline.size}`, `cv-${frame}`, bare && 'ci-bare']}
  data-cards-inline
  data-count={frames}
  data-total={shown}
  data-t-more={inline.more > 0 ? fmt(t.seeAll, { count: inline.total }) : undefined}
  role="region"
  aria-roledescription="carousel"
  aria-label={fmt(t.viewer, { title })}
  data-t-position={t.position}
  data-t-position-long={t.positionLong}
>
  <p class:list={['cv-count ci-count', bare && 'visually-hidden']}>{!bare && <Icon name="cards" class="cv-count-icon" />}{slideCountLabel(t, shown)}</p>
  <div class="ci-stage">
  <div class="ci-track" tabindex="0" aria-label={t.swipeHint} data-track>
    {slides.map((s, i) => (
      <div class="ci-slide" id={`${inline.uid}-${i + 1}`} role="group" aria-roledescription="slide" aria-label={fmt(t.positionLong, { n: i + 1, total: shown })} data-slide={i}>
        <figure class="cv-card">
          <div class="cv-frame">
            <Fragment set:html={inlinePic(s, i)} />
            {(s.heading || s.body) && (
              <figcaption class={`cv-text cv-text-${s.position}`} lang={contentLocale} dir={dir(contentLocale)}>
                {s.heading && <p class="cv-heading">{s.heading}</p>}
                {s.body && <p class="cv-body">{s.body}</p>}
              </figcaption>
            )}
          </div>
        </figure>
      </div>
    ))}
    {inline.more > 0 && (
      <div class="ci-slide" id={`${inline.uid}-${slides.length + 1}`} role="group" aria-roledescription="slide" aria-label={fmt(t.seeAll, { count: inline.total })} data-slide={slides.length}>
        <a class="cv-frame ci-more" href={inline.href}>
          <Icon name="cards" />
          <span>{fmt(t.seeAll, { count: inline.total })}</span>
        </a>
      </div>
    )}
  </div>
  {bare && <slot name="overlay" />}
  {frames > 1 && (
    <div class="ci-nav">
      <button type="button" class="cv-step ci-back" data-step="-1" aria-label={t.back} disabled><Icon name="chevron" class="flip" /></button>
      <p class="cv-pos"><span data-ci-pos aria-hidden="true">{fmt(t.position, { n: 1, total: shown })}</span><span class="visually-hidden" data-ci-live aria-live="polite"></span></p>
      <button type="button" class="cv-step ci-next" data-step="1" aria-label={t.next}><Icon name="chevron" /></button>
    </div>
  )}
  {bare && frames > 1 && (
    <ol class="ci-segs" aria-hidden="true">
      {Array.from({ length: frames }, (_, i) => <li data-ci-seg={i} class:list={[i === 0 && 'is-on']} />)}
    </ol>
  )}
  </div>
</section>
) : (
<section
  class:list={['cards-viewer', `cv-${frame}`]}
  data-cards
  data-count={total}
  data-initial={initial}
  aria-roledescription="carousel"
  aria-label={fmt(t.viewer, { title })}
  data-t-position={t.position}
  data-t-position-long={t.positionLong}
  data-t-enlarge={t.enlarge}
  data-t-close={t.close}
  data-t-next={t.next}
  data-t-back={t.back}
  data-t-lightbox={t.lightbox}
>
  <p class="cv-count"><Icon name="cards" class="cv-count-icon" />{slideCountLabel(t, total)}</p>
  <div class="cv-stage" lang={contentLocale} dir={dir(contentLocale)}>
    <div class="cv-track">
      {slides.map((s, i) => (
        <div class="cv-slide" id={`card-${i + 1}`} role="group" aria-roledescription="slide" aria-label={fmt(t.positionLong, { n: i + 1, total })} hidden={i !== initial} data-slide={i}>
          <figure class="cv-card">
            <div class="cv-frame">
              <Fragment set:html={pic(s, i)} />
              {(s.heading || s.body) && (
                <figcaption class={`cv-text cv-text-${s.position}`}>
                  {s.heading && <h2 class="cv-heading">{s.heading}</h2>}
                  {s.body && <p class="cv-body">{s.body}</p>}
                </figcaption>
              )}
              <button type="button" class="cv-enlarge" data-enlarge aria-label={fmt(t.enlarge, { n: i + 1 })} hidden>
                <Icon name="expand" />
              </button>
            </div>
          </figure>
        </div>
      ))}
    </div>
  </div>
  {total > 1 && (
    <nav class="cv-nav" aria-label={fmt(t.viewer, { title })}>
      <a class="cv-step cv-back" href={href(initial - 1)} rel="prev" data-step="-1" aria-label={t.back} aria-disabled={initial === 0 ? 'true' : undefined} tabindex={initial === 0 ? -1 : undefined}>
        <Icon name="chevron" class="flip" />
      </a>
      <p class="cv-pos"><span data-pos aria-hidden="true">{fmt(t.position, { n: initial + 1, total })}</span><span class="visually-hidden" data-live aria-live="polite">{fmt(t.positionLong, { n: initial + 1, total })}</span></p>
      <a class="cv-step cv-next" href={href(initial + 1)} rel="next" data-step="1" aria-label={t.next} aria-disabled={initial === total - 1 ? 'true' : undefined} tabindex={initial === total - 1 ? -1 : undefined}>
        <Icon name="chevron" />
      </a>
    </nav>
  )}
  {showDots && (
    <ol class="cv-dots">
      {slides.map((_, i) => (
        <li><a href={href(i)} data-go={i} aria-label={fmt(t.goTo, { n: i + 1 })} aria-current={i === initial ? 'step' : undefined}></a></li>
      ))}
    </ol>
  )}
</section>
)}
<script>
  import { initCards } from '../scripts/cards';
  initCards();
</script>
