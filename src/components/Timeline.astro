---
/**
 * The home timeline (src/pages/[locale]/index.astro): pinned items, then items grouped under day
 * headings, then "Load more". Server-rendered and complete without JS ("Load more" is a link to
 * the next page). src/scripts/timeline.ts appends the next pages in place, re-labels the days in
 * the reader's own time zone and keeps the relative times current.
 *
 * Day headings are plain (not sticky): each is short, the cards carry their own time, and a
 * sticky bar would cover the players on phones.
 */
import FeedCard from './FeedCard.astro';
import { strings } from '../i18n';
import { dayLabel, groupByDay, type FeedItem } from '../lib/feed';
import type { Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  pinned: FeedItem[];
  items: FeedItem[];
  nextHref: string | null;
  cmsOrigin: string;
  videosWebUrl: string;
  /** First page: the first image is the LCP candidate (eager); later pages are all lazy. */
  first: boolean;
  now: Date;
}
const { locale, pinned, items, nextHref, cmsOrigin, videosWebUrl, first, now } = Astro.props;
const t = strings(locale).timeline;
const groups = groupByDay(items);
// Only the first image of the first page loads eagerly.
const all = [...pinned, ...items];
const firstImage = first ? all.find((it) => (it.post && (it.post.cover || it.post.first_slide) && !it.post.videos.length)) : undefined;
---
<div
  class="tl"
  data-timeline
  data-locale={locale}
  data-t-today={t.today}
  data-t-yesterday={t.yesterday}
  data-t-added={t.added}
  data-t-added-one={t.addedOne}
  data-t-loading={t.loading}
  data-t-failed={t.failed}
  data-t-end={t.end}
>
  {pinned.length > 0 && (
    <section class="tl-day tl-pinned" aria-labelledby="tl-pinned-h">
      <h3 class="tl-date" id="tl-pinned-h">{t.pinned}</h3>
      <ol class="tl-list">
        {pinned.map((it) => <FeedCard item={it} locale={locale} cmsOrigin={cmsOrigin} videosWebUrl={videosWebUrl} priority={it === firstImage} now={now} />)}
      </ol>
    </section>
  )}
  <div class="tl-days" data-days>
    {groups.map((g) => (
      <section class="tl-day" data-day={g.day} aria-labelledby={`tl-d-${g.day}`}>
        <h3 class="tl-date" id={`tl-d-${g.day}`}>{dayLabel(g.day, now, locale, t)}</h3>
        <ol class="tl-list">
          {g.items.map((it) => <FeedCard item={it} locale={locale} cmsOrigin={cmsOrigin} videosWebUrl={videosWebUrl} priority={it === firstImage} now={now} />)}
        </ol>
      </section>
    ))}
  </div>
  <div class="tl-foot">
    {nextHref ? (
      <a class="button button-quiet tl-more" href={nextHref} data-more rel="next">{t.loadMore}</a>
    ) : (
      items.length > 0 && <p class="tl-end">{t.end}</p>
    )}
    <p class="visually-hidden" aria-live="polite" data-live></p>
  </div>
</div>
<script>
  import { initTimeline } from '../scripts/timeline';
  initTimeline();
</script>
