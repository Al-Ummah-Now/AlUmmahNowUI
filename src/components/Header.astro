---
import Icon from './Icon.astro';
import SearchBox from './SearchBox.astro';
import ThemeIcon from './ThemeIcon.astro';
import { fmt, strings } from '../i18n';
import { navHref } from '../lib/context';
import type { NavItem } from '../lib/cms-types';
import { libraryUrl } from '../lib/embeds';
import type { Config } from '../lib/env';
import { otherLocale, type Locale } from '../lib/locale';

interface Props { cfg: Config; locale: Locale; nav: NavItem[]; switchHref: string }
const { cfg, locale, nav, switchHref } = Astro.props;
const t = strings(locale);
const other = otherLocale(locale);
const path = Astro.url.pathname;
const current = (href: string) => (href === path || (href !== `/${locale}/` && path.startsWith(href)) ? 'page' : undefined);
const items = nav.flatMap((n) => {
  const href = navHref(n.url, locale);
  return href ? [{ label: n.label, href }] : [];
}).slice(0, 6);
const loginHref = `/auth/login?return=${encodeURIComponent(path + Astro.url.search)}`;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={`/${locale}/`} aria-label={t.a11y.home}>
      <img src="/brand/logo-192.webp" alt="" width="40" height="40" />
      {locale === 'ar' ? <span class="brand-ar">الأمة الآن</span> : <span>Al Ummah Now</span>}
    </a>
    <nav class="primary-nav" aria-label={t.a11y.primaryNav}>
      <ul>
        {items.map((i) => (
          <li><a href={i.href} aria-current={current(i.href)}>{i.label}</a></li>
        ))}
      </ul>
    </nav>
    <SearchBox cfg={cfg} locale={locale} id="site-search" />
    <div class="header-tools">
      <div class="theme" id="theme" data-label-current={t.theme.current} data-label-system={t.theme.system} data-label-light={t.theme.light} data-label-dark={t.theme.dark}>
        <button type="button" class="theme-button" aria-expanded="false" aria-controls="theme-menu" data-current="system">
          <span class="visually-hidden" data-theme-name>{fmt(t.theme.current, { mode: t.theme.system })}</span>
          <ThemeIcon mode="system" />
          <ThemeIcon mode="light" />
          <ThemeIcon mode="dark" />
        </button>
        <ul class="theme-menu" id="theme-menu" aria-label={t.theme.label} hidden>
          {(['system', 'light', 'dark'] as const).map((m) => (
            <li>
              <button type="button" data-set-mode={m} aria-pressed={m === 'system' ? 'true' : 'false'}>
                <ThemeIcon mode={m} />
                <span>{t.theme[m]}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <a class="lang-switch" href={switchHref} hreflang={other} lang={other} data-set-locale={other}>{t.lang.switchTo}</a>
      <div
        class="account"
        id="account"
        data-me="/auth/me"
        data-auth-url={cfg.authUrl}
        data-label-accounts={t.auth.accounts}
        data-label-current={t.auth.current}
        data-label-switch-to={t.auth.switchTo}
        data-label-add-account={t.auth.addAccount}
        data-label-sign-out-of={t.auth.signOutOf}
        data-label-sign-out-all={t.auth.signOutAll}
        data-label-menu={t.a11y.accountMenu}
        data-label-signed-in-as={t.auth.signedInAs}
        data-label-profile={t.auth.profile}
        data-label-videos={t.auth.videos}
        data-label-cms={t.auth.cms}
        data-label-sign-out={t.auth.signOut}
        data-label-confirm-sign-out-of-title={t.auth.confirmSignOutOfTitle}
        data-label-confirm-sign-out-of-body={t.auth.confirmSignOutOfBody}
        data-label-confirm-sign-out-all-title={t.auth.confirmSignOutAllTitle}
        data-label-confirm-sign-out-all-body={t.auth.confirmSignOutAllBody}
        data-profile-url={cfg.profileUrl}
        data-videos-url={libraryUrl(cfg.videosWebUrl, locale)}
        data-cms-url={`${cfg.cmsPublicUrl}/`}
        data-locale={locale}
      >
        <a class="signin-link" href={loginHref} rel="nofollow">{t.auth.signIn}</a>
      </div>
    </div>
  </div>
  <template id="caret-icon"><Icon name="caret" /></template>
  <!-- the one in-app confirmation for destructive actions (./scripts/confirm.ts); never window.confirm -->
  <dialog class="confirm-dialog" id="confirm-dialog" aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-body">
    <div class="confirm-dialog-inner">
      <h2 class="confirm-dialog-title" id="confirm-dialog-title"></h2>
      <p class="confirm-dialog-body" id="confirm-dialog-body"></p>
      <div class="confirm-dialog-actions">
        <button type="button" class="confirm-dialog-cancel" data-confirm-cancel>{t.auth.cancel}</button>
        <button type="button" class="confirm-dialog-ok" data-confirm-ok></button>
      </div>
    </div>
  </dialog>
</header>
