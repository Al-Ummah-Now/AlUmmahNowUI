---
/** A CMS page as published (src/pages/[locale]/[slug].astro) and as previewed (src/pages/preview/). */
import type { Page } from '../lib/cms-types';
import { dir } from '../lib/locale';
import { pictureHtml, SIZES } from '../lib/picture';

interface Props { page: Page; html: string; cmsOrigin: string }
const { page, html, cmsOrigin } = Astro.props;
// The cover is the page's LCP image: responsive, sized, eager and high priority (CMS-10).
const coverHtml = page.cover ? pictureHtml(page.cover, cmsOrigin, { sizes: SIZES.cover, priority: true, className: 'cover' }) : null;
---
<article>
  <header class="page-head">
    <div class="wrap">
      <h1>{page.title}</h1>
      {page.summary && <p class="lede">{page.summary}</p>}
      {coverHtml && <Fragment set:html={coverHtml} />}
    </div>
  </header>
  <div class="section">
    <div class="wrap">
      <div class="prose" lang={page.locale} dir={dir(page.locale)} set:html={html} />
    </div>
  </div>
</article>
