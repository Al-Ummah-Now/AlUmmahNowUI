---
/** A CMS post as published (src/pages/[locale]/news/[slug].astro) and as previewed (src/pages/preview/). */
import Icon from './Icon.astro';
import { fmt, formatDate, strings } from '../i18n';
import type { Post } from '../lib/cms-types';
import { dir, type Locale } from '../lib/locale';
import { pictureHtml, SIZES } from '../lib/picture';

interface Props { post: Post; html: string; locale: Locale; cmsOrigin: string }
const { post, html, locale, cmsOrigin } = Astro.props;
// The cover is the article's LCP image: responsive, sized, eager and high priority (CMS-10).
const coverHtml = post.cover ? pictureHtml(post.cover, cmsOrigin, { sizes: SIZES.cover, priority: true, className: 'cover' }) : null;
const t = strings(locale);
---
<article>
  <header class="page-head">
    <div class="wrap">
      <p><a class="more-link" href={`/${locale}/news/`}><Icon name="chevron" class="flip" />{t.news.backToNews}</a></p>
      <h1>{post.title}</h1>
      {post.excerpt && <p class="lede">{post.excerpt}</p>}
      <p class="byline">
        <time datetime={post.published_at}>{formatDate(post.published_at, post.locale)}</time>
        {post.author_name && <span>{' '}{fmt(t.news.by, { author: post.author_name })}</span>}
      </p>
      {coverHtml && <Fragment set:html={coverHtml} />}
    </div>
  </header>
  <div class="section">
    <div class="wrap">
      <div class="prose" lang={post.locale} dir={dir(post.locale)} set:html={html} />
      {post.tags.length > 0 && (
        <div class="section-tags">
          <h2 class="visually-hidden">{t.news.tags}</h2>
          <ul class="tags">{post.tags.map((tag) => <li>{tag}</li>)}</ul>
        </div>
      )}
    </div>
  </div>
</article>
