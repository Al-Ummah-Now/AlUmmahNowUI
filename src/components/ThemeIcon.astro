---
/** Icons for the Light / Dark / System control (decorative: the control names the mode in text). */
interface Props { mode: 'system' | 'light' | 'dark' }
const { mode } = Astro.props;
---
{mode === 'system' && (
  <svg class="theme-icon" data-icon="system" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="3.5" width="15" height="10" rx="1.5" /><path d="M7 16.5h6M10 13.5v3" /></g><path d="M10 5.5v6a3 3 0 0 0 0-6z" fill="currentColor" /></svg>
)}
{mode === 'light' && (
  <svg class="theme-icon" data-icon="light" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="10" cy="10" r="3.5" /><path d="M10 1.75v2M10 16.25v2M1.75 10h2M16.25 10h2M4.17 4.17l1.41 1.41M14.42 14.42l1.41 1.41M4.17 15.83l1.41-1.41M14.42 5.58l1.41-1.41" /></g></svg>
)}
{mode === 'dark' && (
  <svg class="theme-icon" data-icon="dark" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M16.5 12.6A6.75 6.75 0 0 1 7.4 3.5a6.75 6.75 0 1 0 9.1 9.1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
)}
