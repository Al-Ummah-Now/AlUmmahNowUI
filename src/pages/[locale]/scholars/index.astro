---
/** The scholars directory (AlUmmahNowCMS docs/SCHOLARS.md §3): every scholar with a page, by name. */
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { fmt } from '../../../i18n';
import { SCHOLARS_PAGE_SIZE as PAGE_SIZE } from '../../../lib/cms';
import { loadChrome, markSource, requestContext, routeLocale } from '../../../lib/context';
import { pictureHtml } from '../../../lib/picture';

const locale = routeLocale(Astro);
if (!locale) return new Response(null, { status: 404 });
const raw = Astro.url.searchParams.get('page');
const page = raw === null ? 1 : /^[1-9]\d{0,3}$/.test(raw) ? Number(raw) : NaN;
if (!Number.isFinite(page)) return new Response(null, { status: 404 });

const rc = requestContext(Astro, locale);
const { cfg, t } = rc;
const [chrome, res] = await Promise.all([loadChrome(rc), rc.cms.scholars(locale, page, PAGE_SIZE)]);
const list = res.status === 'ok' ? res.data : { items: [], page, limit: PAGE_SIZE, total: 0 };
const pages = Math.max(1, Math.ceil(list.total / PAGE_SIZE));
if (page > 1 && list.items.length === 0 && res.source === 'cms') return new Response(null, { status: 404 });
markSource(Astro, rc);
const cmsOrigin = new URL(cfg.cmsPublicUrl).origin;
const qs = (p: number) => (p === 1 ? '' : `?page=${p}`);
const title = page > 1 ? `${t.scholars.title}: ${fmt(t.articles.pageOf, { page, pages })}` : t.scholars.title;
---
<BaseLayout
  cfg={cfg}
  locale={locale}
  title={title}
  description={t.scholars.intro}
  alternates={{ en: `/en/scholars/${qs(page)}`, ar: `/ar/scholars/${qs(page)}` }}
  nav={chrome.nav}
  settings={chrome.settings}
>
  <div class="page-head">
    <div class="wrap">
      <h1>{t.scholars.title}</h1>
      <p class="lede">{t.scholars.intro}</p>
    </div>
  </div>
  <section class="section" aria-label={t.scholars.title}>
    <div class="wrap">
      {list.items.length > 0 ? (
        <>
          <ul class="scholar-grid">
            {list.items.map((s) => (
              <li>
                <a class="scholar-card" href={`/${locale}/scholars/${encodeURIComponent(s.slug)}/`}>
                  {s.avatar ? (
                    <Fragment set:html={pictureHtml(s.avatar, cmsOrigin, { sizes: '4rem', className: 'scholar-avatar', alt: '' })} />
                  ) : (
                    <span class="scholar-avatar scholar-avatar-empty" aria-hidden="true">{s.name.slice(0, 1)}</span>
                  )}
                  <span class="scholar-card-text">
                    <span class="scholar-name" dir="auto">{s.name}</span>
                    {s.bio_excerpt && <span class="scholar-bio" dir="auto">{s.bio_excerpt}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {pages > 1 && (
            <nav class="pagination" aria-label={t.a11y.pagination}>
              {page > 1 && <a href={`/${locale}/scholars/${qs(page - 1)}`} rel="prev"><Icon name="chevron" class="flip" />{t.articles.newer}</a>}
              <p aria-current="page">{fmt(t.articles.pageOf, { page, pages })}</p>
              {page < pages && <a href={`/${locale}/scholars/${qs(page + 1)}`} rel="next">{t.articles.older}<Icon name="chevron" /></a>}
            </nav>
          )}
        </>
      ) : (
        <div class="empty"><p>{t.scholars.empty}</p></div>
      )}
    </div>
  </section>
</BaseLayout>
