---
/**
 * Home (docs/specs/WWW-PAGES.md D1): the hero, then the timeline, nothing else. The timeline is the
 * CMS-managed feed of posts, card posts, videos, playlists and channels, read from Workers KV
 * (src/lib/feed.ts), pinned first then newest first, with "Load more" (?before=<cursor>). When the
 * feed is missing the timeline is the CMS posts list (cache → CMS → snapshot → built-in), so the
 * page never fails. Videos and Articles are reached from the site menu.
 *
 * ?before= pages (no-JS "Load more", and what the script fetches) show only the timeline.
 */
import Icon from '../../components/Icon.astro';
import Timeline from '../../components/Timeline.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { libraryUrl } from '../../lib/embeds';
import { loadChrome, markSource, requestContext, routeLocale } from '../../lib/context';
import { parseCursor } from '../../lib/feed';
import { organizationLd, websiteLd } from '../../lib/seo';
import { loadTimeline } from '../../lib/timeline';

const locale = routeLocale(Astro);
if (!locale) return new Response(null, { status: 404 });
const rawBefore = Astro.url.searchParams.get('before');
const rawPage = Astro.url.searchParams.get('page');
if (rawBefore !== null && !parseCursor(rawBefore)) return new Response(null, { status: 404 });
const page = rawPage === null ? 1 : /^[1-9]\d{0,3}$/.test(rawPage) ? Number(rawPage) : NaN;
if (!Number.isFinite(page)) return new Response(null, { status: 404 });
const later = rawBefore !== null || page > 1;

const rc = requestContext(Astro, locale);
const { cfg, t } = rc;
const now = new Date();
const [chrome, timeline] = await Promise.all([
  loadChrome(rc),
  loadTimeline({ kv: rc.env.FEED, cms: rc.cms, locale, before: rawBefore, page, log: (msg, data) => console.warn(JSON.stringify({ msg, ...data })) }),
]);
const settings = chrome.settings;
markSource(Astro, rc);
Astro.response.headers.set('X-Feed-Source', timeline.source);

const heroTitle = settings?.hero_title || t.home.heroTitle;
const heroBody = settings?.hero_body || t.home.heroBody;
const siteName = settings?.site_title || t.meta.siteName;
const sameAs = (settings?.social ?? []).map((s) => s.url).filter((u) => u.startsWith('https://'));
const videosHref = libraryUrl(cfg.videosWebUrl, locale);
const cmsOrigin = new URL(cfg.cmsPublicUrl).origin;
const empty = timeline.pinned.length === 0 && timeline.items.length === 0;
---
<BaseLayout
  cfg={cfg}
  locale={locale}
  title={later ? t.timeline.olderTitle : siteName}
  description={settings?.tagline ? `${settings.tagline}. ${t.meta.defaultDescription}` : t.meta.defaultDescription}
  alternates={{ en: '/en/', ar: '/ar/' }}
  nav={chrome.nav}
  settings={settings}
  noindex={later}
  jsonLd={later ? [] : [organizationLd(cfg, siteName, sameAs), websiteLd(cfg, siteName, locale)]}
>
  {!later && (
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <div>
          <p class="hero-wordmark" lang="ar" dir="rtl">الأمة الآن</p>
          {locale === 'en' && <p class="hero-latin">{t.home.wordmarkLatin}</p>}
          <h1 id="hero-title">{heroTitle}</h1>
          <p class="hero-body">{heroBody}</p>
          <div class="hero-actions">
            <a class="button button-primary" href={videosHref}>{t.home.watchCta}<Icon name="arrow" /></a>
            <a class="button button-ghost" href={cfg.profileUrl}>{t.home.profileCta}</a>
          </div>
        </div>
        <img class="hero-lantern" src="/brand/logo-512.webp" alt="" width="512" height="512" fetchpriority="high" />
      </div>
    </section>
  )}

  <section class="section tl-section" aria-labelledby="timeline-title">
    <div class="tl-wrap">
      <div class="tl-head">
        {later ? <h1 id="timeline-title">{t.timeline.olderTitle}</h1> : <h2 id="timeline-title">{t.timeline.title}</h2>}
        <p class="tl-intro">{t.timeline.intro}</p>
      </div>
      {empty ? (
        <div class="empty">
          <p>{t.timeline.empty}</p>
          <a class="button button-quiet" href={videosHref}>{t.home.watchCta}</a>
        </div>
      ) : (
        <Timeline
          locale={locale}
          pinned={timeline.pinned}
          items={timeline.items}
          nextHref={timeline.nextHref}
          cmsOrigin={cmsOrigin}
          videosWebUrl={cfg.videosWebUrl}
          first={!later}
          now={now}
        />
      )}
    </div>
  </section>
</BaseLayout>
