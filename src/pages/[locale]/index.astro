---
import Icon from '../../components/Icon.astro';
import NewsList from '../../components/NewsList.astro';
import VideoRail from '../../components/VideoRail.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { builtinContent } from '../../content/fallback';
import { libraryUrl } from '../../lib/embeds';
import { loadChrome, markSource, requestContext, routeLocale } from '../../lib/context';
import { organizationLd, websiteLd } from '../../lib/seo';
import { resolveCurated } from '../../lib/videos';

const locale = routeLocale(Astro);
if (!locale) return new Response(null, { status: 404 });
const rc = requestContext(Astro, locale);
const { cfg, t } = rc;
const [chrome, home] = await Promise.all([loadChrome(rc), rc.cms.home(locale)]);
const builtin = builtinContent(locale);
const data = home.status === 'ok' ? home.data : builtin.home;
const settings = data.settings ?? chrome.settings;
const curated = await resolveCurated(rc.videos, data.videos, locale);
markSource(Astro, rc);

const heroTitle = settings?.hero_title || t.home.heroTitle;
const heroBody = settings?.hero_body || t.home.heroBody;
const siteName = settings?.site_title || t.meta.siteName;
const sameAs = (settings?.social ?? []).map((s) => s.url).filter((u) => u.startsWith('https://'));
const videosHref = libraryUrl(cfg.videosWebUrl, locale);
const loginHref = `/auth/login?return=${encodeURIComponent(`/${locale}/`)}`;
---
<BaseLayout
  cfg={cfg}
  locale={locale}
  title={siteName}
  description={settings?.tagline ? `${settings.tagline}. ${t.meta.defaultDescription}` : t.meta.defaultDescription}
  alternates={{ en: '/en/', ar: '/ar/' }}
  nav={chrome.nav}
  settings={settings}
  jsonLd={[organizationLd(cfg, siteName, sameAs), websiteLd(cfg, siteName, locale)]}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div>
        <p class="hero-wordmark" lang="ar" dir="rtl">الأمة الآن</p>
        {locale === 'en' && <p class="hero-latin">{t.home.wordmarkLatin}</p>}
        <h1 id="hero-title">{heroTitle}</h1>
        <p class="hero-body">{heroBody}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={videosHref}>{t.home.watchCta}<Icon name="arrow" /></a>
          <a class="button button-ghost" href={cfg.profileUrl}>{t.home.profileCta}</a>
        </div>
      </div>
      <img class="hero-lantern" src="/brand/logo-512.webp" alt="" width="512" height="512" fetchpriority="high" />
    </div>
  </section>

  <section class="section" aria-labelledby="what-title">
    <div class="wrap">
      <div class="section-head"><h2 id="what-title">{t.home.whatTitle}</h2></div>
      <ul class="pillars">
        {builtin.pillars.map((p) => (
          <li class="pillar">
            <Icon name="star" />
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Empty rails are hidden on the home page (the /videos and /news pages carry the empty states) */}
  {curated.length > 0 && (
    <section class="section" aria-labelledby="curated-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="curated-title">{t.home.curatedTitle}</h2>
          <a class="more-link" href={`/${locale}/videos/`}>{t.home.curatedAll}<Icon name="chevron" /></a>
        </div>
        <VideoRail cfg={cfg} locale={locale} items={curated} />
      </div>
    </section>
  )}

  {data.posts.length > 0 && (
    <section class="section" aria-labelledby="news-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="news-title">{t.home.newsTitle}</h2>
          <a class="more-link" href={`/${locale}/news/`}>{t.home.newsAll}<Icon name="chevron" /></a>
        </div>
        <NewsList locale={locale} posts={data.posts.slice(0, 3)} headingLevel={3} />
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="apps-title">
    <div class="wrap">
      <div class="section-head"><h2 id="apps-title">{t.home.appsTitle}</h2></div>
      <ul class="apps">
        <li><a class="app-link" href={videosHref}><strong>{t.apps.videosTitle}<Icon name="arrow" /></strong><span>{t.apps.videosBody}</span></a></li>
        <li><a class="app-link" href={cfg.profileUrl}><strong>{t.apps.profileTitle}<Icon name="arrow" /></strong><span>{t.apps.profileBody}</span></a></li>
        <li><a class="app-link" href={loginHref} rel="nofollow"><strong>{t.apps.signInTitle}<Icon name="arrow" /></strong><span>{t.apps.signInBody}</span></a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
