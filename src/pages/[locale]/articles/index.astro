---
/**
 * /articles: the CMS list page `articles` (a filter page: every published article and card post,
 * docs/specs/WWW-PAGES.md D3), or www's built-in filter page from /posts when the CMS has none or
 * the list cannot be read. ?page=N: 404 for a bad value, and past the last page when the CMS says so.
 */
import ListPage from '../../../components/ListPage.astro';
import { libraryUrl } from '../../../lib/embeds';
import { loadChrome, markSource, requestContext, routeLocale } from '../../../lib/context';
import { loadList, otherLocaleList, pageQuery, parsePage } from '../../../lib/list-page';

const locale = routeLocale(Astro);
if (!locale) return new Response(null, { status: 404 });
const page = parsePage(Astro.url.searchParams.get('page'));
if (page === null) return new Response(null, { status: 404 });

const rc = requestContext(Astro, locale);
const { cfg, t } = rc;
const [chrome, list] = await Promise.all([loadChrome(rc), loadList({ cms: rc.cms, locale, slug: 'articles', page, builtin: 'articles' })]);
if (list.status !== 'ok') return new Response(null, { status: 404 });
// Nothing in this locale: point at the other locale's list when it has items (docs/SPEC.md §4).
const otherHref = await otherLocaleList(rc.cms, locale, list.view, 'articles');
markSource(Astro, rc);
---
<ListPage
  cfg={cfg}
  locale={locale}
  nav={chrome.nav}
  settings={chrome.settings}
  view={list.view}
  path={`/${locale}/articles/`}
  alternates={{ en: `/en/articles/${pageQuery(page)}`, ar: `/ar/articles/${pageQuery(page)}` }}
  otherHref={otherHref}
>
  <div slot="empty" class="empty">
    <p>{t.articles.empty}</p>
    <p>{t.articles.emptyHint}</p>
    <a class="button button-quiet" href={libraryUrl(cfg.videosWebUrl, locale)}>{t.home.watchCta}</a>
  </div>
</ListPage>
