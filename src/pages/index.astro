---
import '../styles/global.css'; // Import the global CSS file
import { fetchSonicJSData } from '../utils/api';

interface ContentItem {
  id: string;
  title: string;
  body: string;
  userId: string;
  image: string | null;
  images: string[] | null;
  tags: string[] | null;
  createdOn: number;
  updatedOn: number;
}

const response = await fetchSonicJSData('https://al-ummah-now-cms.pages.dev/api/v1/posts');
const data: ContentItem[] = response.data; // Access the 'data' array from the API response
---
<html>
  <head>
    <title>Al Ummah Now</title>
  </head>
  <body class="bg-gradient-to-b from-bg-start to-bg-end text-onBackground relative">
    <header class="absolute top-0 left-0 w-full h-48 sm:h-64 md:h-72 bg-cover bg-center z-10" style="background-image: url('/alummah now bg3.png');">
      <!-- No text inside the header -->
    </header>
    <main class="relative z-0 pt-48 sm:pt-64 md:pt-72 p-6 max-w-4xl mx-auto">
      <h1 class="text-3xl font-medium mb-6 text-primary">Content from SonicJS</h1>
      <ul class="space-y-4">
        {data?.map((item: ContentItem) => (
          <li class="p-4 bg-surface text-onSurface rounded-lg shadow-md-elevation hover:shadow-lg-elevation transition-shadow duration-300">
            <h2 class="text-xl font-semibold text-primary mb-2">{item.title}</h2>
            <p class="text-secondary">{item.body}</p>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
