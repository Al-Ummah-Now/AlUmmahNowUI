{
  "name": "al-ummah-now-www",
  "description": "www.alummahnow.net: the public site of Al Ummah Now (Astro on Cloudflare Workers).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node --experimental-strip-types --no-warnings scripts/dev-vars.ts && wrangler dev --port ${WWW_PORT:-4321}",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:config": "node --experimental-strip-types --no-warnings scripts/check-wrangler-config.ts",
    "check:secrets": "node --experimental-strip-types --no-warnings scripts/release/check-secrets.ts",
    "release:promote": "node --experimental-strip-types --no-warnings scripts/release/promote.ts",
    "release:smoke": "node --experimental-strip-types --no-warnings scripts/release/smoke.ts",
    "release:rollback": "node --experimental-strip-types --no-warnings scripts/release/rollback.ts",
    "cf-typegen": "wrangler types --env-file .dev.vars.example --strict-vars=false",
    "check:committed-secrets": "node scripts/check-committed-secrets.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "5.18.2",
    "jose": "6.2.15",
    "markdown-it": "15.0.3",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261108.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7",
    "wrangler": "4.158.0"
  }
}
