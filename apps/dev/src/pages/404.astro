---
/**
 * The 404 page (Workers static assets serve dist/404.html with a 404 status for unknown paths): the
 * Al Ummah Now error card (packages/render/src/error-page.ts, wiki guides/error-pages.md) in the
 * site's header and footer. The address doesn't tell us the language, so the page shows the card in
 * both, each with its own lang/dir (English first, the Arabic card's heading an h2). noindex.
 */
import '../../../../packages/render/src/styles/fanous-themes.generated.css';
import '../styles/site.css';
import '../../../www/src/styles/aun-nav.generated.css';
import '../../../www/src/styles/header.css';
import '../../../../packages/render/src/styles/aun-error-page.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { strings } from '../i18n';
import { errorCardHtml, ERROR_CARD_STRINGS } from '../../../../packages/render/src/error-page';

const t = strings('en');
const card = (locale: 'en' | 'ar', headingLevel: 1 | 2) =>
  errorCardHtml({
    locale,
    kind: 'notFound',
    headingLevel,
    buttonClass: { primary: 'button button-primary', secondary: 'button button-quiet' },
    primary: { label: ERROR_CARD_STRINGS[locale].goHome, href: `/${locale}/`, icon: 'home' },
    back: locale === 'en',
    contactHref: `/${locale}/contact/`,
  });
---
<!doctype html>
<html lang="en" dir="ltr" data-theme="fawanees">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/mode.js"></script>
    <title>{ERROR_CARD_STRINGS.en.kinds.notFound.title} · {ERROR_CARD_STRINGS.ar.kinds.notFound.title} | Al Ummah Now</title>
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/noto-naskh-arabic-arabic-400-normal.woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header locale="en" slug="" t={t} />
    <main id="main" tabindex="-1" class="ep-pair">
      <Fragment set:html={card('en', 1)} />
      <Fragment set:html={card('ar', 2)} />
    </main>
    <Footer locale="en" t={t} />
    <script is:inline src="/ep-back.js" defer></script>
  </body>
</html>
