---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ItemGrid from '../../../components/ItemGrid.astro';
import { strings } from '../../../i18n';
import type { Locale } from '../../../lib/pages';
import { contactUrl } from '../../../lib/links';
import { localePaths } from '../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const p = t.waqf;
---
<Base locale={locale} slug="waqf" title={p.title} description={p.description}>
  <PageHero title={p.heroTitle} lead={p.heroLead} />
  <section class="band" aria-labelledby="what-h">
    <div class="wrap">
      <div class="waqf-def">
        <span class="waqf-glyph" aria-hidden="true" lang="ar">وقف</span>
        <div>
          <h2 id="what-h" class="h2">{p.whatTitle}</h2>
          <p class="waqf-def-body">{p.whatBody}</p>
        </div>
      </div>
    </div>
  </section>
  <section class="band band-raised" aria-labelledby="why-h">
    <div class="wrap">
      <h2 id="why-h" class="h2">{p.whyTitle}</h2>
      <ul class="pillars pillars-3" role="list">
        {p.why.map((w) => (
          <li class="pillar"><h3 class="pillar-title">{w.title}</h3><p>{w.body}</p></li>
        ))}
      </ul>
    </div>
  </section>
  <section class="band" aria-labelledby="today-h">
    <div class="wrap">
      <h2 id="today-h" class="h2">{p.todayTitle}</h2>
      <ItemGrid items={p.today} t={t} />
    </div>
  </section>
  <section class="band band-raised" aria-labelledby="open-h">
    <div class="wrap split">
      <div>
        <h2 id="open-h" class="h2">{p.openTitle}</h2>
        <ul class="open-list" role="list">{p.open.map((o) => <li>{o}</li>)}</ul>
      </div>
      <div class="panel panel-glow">
        <h2 class="h2">{p.helpTitle}</h2>
        <p>{p.helpBody}</p>
        <p><a class="button button-primary" href={contactUrl(locale, 'partnership')} rel="external">{p.helpLink}</a></p>
      </div>
    </div>
  </section>
</Base>
