---
import SystemDesignPage from '../../../../components/SystemDesignPage.astro';
import SdDiagram from '../../../../components/SdDiagram.astro';
import { strings } from '../../../../i18n';
import type { Locale } from '../../../../lib/pages';
import { localePaths } from '../../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const block = t.systemDesignPages.cost;
const d = t.diagrams.pages.cost;
---
<SystemDesignPage locale={locale} slug="system-design/cost" t={t} block={block}>
  <SdDiagram id="costs" locale={locale} title={t.diagrams.costs.title} costs />
  <SdDiagram id="cost-monitor" locale={locale} title={d.monitor.title} lead={d.monitor.lead} raised />
  <SdDiagram id="cost-cheap" locale={locale} title={d.cheap.title} lead={d.cheap.lead} />
</SystemDesignPage>
