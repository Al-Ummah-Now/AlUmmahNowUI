---
import SystemDesignPage from '../../../../components/SystemDesignPage.astro';
import SdDiagram from '../../../../components/SdDiagram.astro';
import { strings } from '../../../../i18n';
import type { Locale } from '../../../../lib/pages';
import { localePaths } from '../../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const block = t.systemDesignPages.asyncWork;
const d = t.diagrams.pages.async;
---
<SystemDesignPage locale={locale} slug="system-design/async" t={t} block={block}>
  <SdDiagram id="async-queues" locale={locale} title={d.queues.title} lead={d.queues.lead} />
  <SdDiagram id="async-fail" locale={locale} title={d.fail.title} lead={d.fail.lead} raised />
  <SdDiagram id="async-crons" locale={locale} title={d.crons.title} lead={d.crons.lead} />
</SystemDesignPage>
