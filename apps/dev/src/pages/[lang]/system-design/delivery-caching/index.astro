---
import SystemDesignPage from '../../../../components/SystemDesignPage.astro';
import SdDiagram from '../../../../components/SdDiagram.astro';
import { strings } from '../../../../i18n';
import type { Locale } from '../../../../lib/pages';
import { localePaths } from '../../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const block = t.systemDesignPages.deliveryCaching;
const d = t.diagrams.pages.delivery;
---
<SystemDesignPage locale={locale} slug="system-design/delivery-caching" t={t} block={block}>
  <SdDiagram id="delivery-rails" locale={locale} title={d.rails.title} lead={d.rails.lead} />
  <SdDiagram id="delivery-miss" locale={locale} title={d.miss.title} lead={d.miss.lead} raised />
  <SdDiagram id="delivery-caches" locale={locale} title={d.caches.title} lead={d.caches.lead} />
</SystemDesignPage>
