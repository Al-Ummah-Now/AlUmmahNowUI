---
import SystemDesignPage from '../../../../components/SystemDesignPage.astro';
import SdDiagram from '../../../../components/SdDiagram.astro';
import { strings } from '../../../../i18n';
import type { Locale } from '../../../../lib/pages';
import { localePaths } from '../../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const block = t.systemDesignPages.clients;
const d = t.diagrams.pages.clients;
---
<SystemDesignPage locale={locale} slug="system-design/clients" t={t} block={block}>
  <SdDiagram id="clients-map" locale={locale} title={d.map.title} lead={d.map.lead} />
  <SdDiagram id="clients-device" locale={locale} title={d.device.title} lead={d.device.lead} raised />
  <SdDiagram id="clients-core" locale={locale} title={d.core.title} lead={d.core.lead} />
</SystemDesignPage>
