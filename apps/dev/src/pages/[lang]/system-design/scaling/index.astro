---
import SystemDesignPage from '../../../../components/SystemDesignPage.astro';
import SdDiagram from '../../../../components/SdDiagram.astro';
import { strings } from '../../../../i18n';
import type { Locale } from '../../../../lib/pages';
import { localePaths } from '../../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const block = t.systemDesignPages.scaling;
const d = t.diagrams.pages.scaling;
---
<SystemDesignPage locale={locale} slug="system-design/scaling" t={t} block={block}>
  <SdDiagram id="scaling-copies" locale={locale} title={d.copies.title} lead={d.copies.lead} />
  <SdDiagram id="scaling-slot" locale={locale} title={d.slot.title} lead={d.slot.lead} raised />
  <SdDiagram id="scaling-fixes" locale={locale} title={d.fixes.title} lead={d.fixes.lead} />
</SystemDesignPage>
