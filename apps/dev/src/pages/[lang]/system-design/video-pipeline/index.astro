---
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import ItemGrid from '../../../../components/ItemGrid.astro';
import ArchFigure from '../../../../components/ArchFigure.astro';
import { strings } from '../../../../i18n';
import type { Locale } from '../../../../lib/pages';
import { localePaths } from '../../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const p = t.videoPipeline;
---
<Base locale={locale} slug="system-design/video-pipeline" title={p.title} description={p.description}>
  <PageHero title={p.heroTitle} lead={p.heroLead} />
  <section class="band" aria-labelledby="logoflow-h">
    <div class="wrap">
      <ArchFigure id="pipeline" locale={locale} title={p.logoFlow.title} lead={p.diagramLead} headingId="logoflow-h" />
    </div>
  </section>
  <section class="band band-raised" aria-labelledby="sketch-h">
    <div class="wrap">
      <ArchFigure id="sketch-play" locale={locale} title={t.diagrams.sketch.title} headingId="sketch-h" />
    </div>
  </section>
  <section class="band" aria-labelledby="stages-h">
    <div class="wrap">
      <h2 id="stages-h" class="h2">{p.stagesTitle}</h2>
      <ItemGrid items={p.stages} t={t} />
    </div>
  </section>
</Base>
