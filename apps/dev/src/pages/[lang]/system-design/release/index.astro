---
import SystemDesignPage from '../../../../components/SystemDesignPage.astro';
import SdDiagram from '../../../../components/SdDiagram.astro';
import { strings } from '../../../../i18n';
import type { Locale } from '../../../../lib/pages';
import { localePaths } from '../../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const block = t.systemDesignPages.release;
const d = t.diagrams.pages.release;
---
<SystemDesignPage locale={locale} slug="system-design/release" t={t} block={block}>
  <SdDiagram id="release-train" locale={locale} title={d.train.title} lead={d.train.lead} />
  <SdDiagram id="release-who" locale={locale} title={d.who.title} lead={d.who.lead} raised />
  <SdDiagram id="release-gates" locale={locale} title={d.gates.title} lead={d.gates.lead} />
</SystemDesignPage>
