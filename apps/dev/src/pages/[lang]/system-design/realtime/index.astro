---
import SystemDesignPage from '../../../../components/SystemDesignPage.astro';
import SdDiagram from '../../../../components/SdDiagram.astro';
import { strings } from '../../../../i18n';
import type { Locale } from '../../../../lib/pages';
import { localePaths } from '../../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const block = t.systemDesignPages.realtime;
const d = t.diagrams.pages.realtime;
---
<SystemDesignPage locale={locale} slug="system-design/realtime" t={t} block={block}>
  <SdDiagram id="realtime-map" locale={locale} title={d.map.title} lead={d.map.lead} />
  <SdDiagram id="realtime-views" locale={locale} title={d.views.title} lead={d.views.lead} raised />
  <SdDiagram id="realtime-sketch" locale={locale} title={d.sketch.title} lead={d.sketch.lead} />
</SystemDesignPage>
