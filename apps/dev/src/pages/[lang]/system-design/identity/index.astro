---
import SystemDesignPage from '../../../../components/SystemDesignPage.astro';
import SdDiagram from '../../../../components/SdDiagram.astro';
import { strings } from '../../../../i18n';
import type { Locale } from '../../../../lib/pages';
import { localePaths } from '../../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const block = t.systemDesignPages.identity;
const d = t.diagrams.pages.identity;
---
<SystemDesignPage locale={locale} slug="system-design/identity" t={t} block={block}>
  <SdDiagram id="identity-map" locale={locale} title={d.map.title} lead={d.map.lead} />
  <SdDiagram id="identity-signin" locale={locale} title={d.signin.title} lead={d.signin.lead} raised />
  <SdDiagram id="identity-roles" locale={locale} title={d.roles.title} lead={d.roles.lead} />
</SystemDesignPage>
