---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ItemGrid from '../../../components/ItemGrid.astro';
import Sources from '../../../components/Sources.astro';
import { strings } from '../../../i18n';
import type { Locale } from '../../../lib/pages';
import { localePaths } from '../../../lib/static-paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = strings(locale);
const p = t.technology;
---
<Base locale={locale} slug="technology" title={p.title} description={p.description}>
  <PageHero title={p.heroTitle} lead={p.heroLead} />
  <section class="band" aria-labelledby="groups-h">
    <div class="wrap">
      <h2 id="groups-h" class="visually-hidden">{p.title}</h2>
      <div class="groups">
        {p.groups.map((g) => (
          <section class="group" aria-label={g.title}>
            <h3 class="group-title">{g.title}</h3>
            <ItemGrid items={g.items} t={t} cols={g.items.length >= 3 ? 3 : 2} />
          </section>
        ))}
      </div>
    </div>
  </section>
  <section class="band band-raised" aria-labelledby="principles-h">
    <div class="wrap">
      <h2 id="principles-h" class="h2">{p.principlesTitle}</h2>
      <ul class="principles" role="list">
        {p.principles.map((x) => (
          <li class="principle">
            <h3 class="tile-title">{x.title}</h3>
            <p>{x.body}</p>
            <Sources links={x.sources} label={t.common.source} plural={t.common.sources} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
