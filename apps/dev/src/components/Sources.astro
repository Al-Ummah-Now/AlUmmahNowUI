---
/** The wiki pages (or specs) a claim comes from, as small links under it. */
import type { Link } from '../i18n';
interface Props {
  links?: Link[];
  label: string;
  plural: string;
}
const { links = [], label, plural } = Astro.props;
---
{links.length > 0 && (
  <p class="sources">
    <span class="sources-label">{links.length > 1 ? plural : label}:</span>
    {links.map((l, i) => (
      <>
        {i > 0 && <span aria-hidden="true">, </span>}
        <a href={l.href} rel="external">{l.label}</a>
      </>
    ))}
  </p>
)}
