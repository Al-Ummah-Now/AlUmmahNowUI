---
/**
 * A sequence (the video pipeline) as numbered steps joined by a line. A real ordered list, so the order is
 * announced; the line is decoration. Desktop: across (right to left in Arabic, by the grid's direction).
 * Phones: down the start edge.
 */
interface Props {
  steps: { title: string; body: string }[];
  label: string;
}
const { steps, label } = Astro.props;
---
<ol class="flow" aria-label={label}>
  {steps.map((s, i) => (
    <li class="flow-step">
      <span class="flow-n" aria-hidden="true">{i + 1}</span>
      <h3 class="flow-title">{s.title}</h3>
      <p class="flow-body">{s.body}</p>
    </li>
  ))}
</ol>
