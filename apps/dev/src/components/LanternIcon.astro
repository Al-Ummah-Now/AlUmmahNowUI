---
/** A small lit lantern for the lantern-street diagrams. Decorative: the step text carries the meaning. */
interface Props {
  uid: string;
}
const { uid } = Astro.props;
---
<svg class="lantern-icon" viewBox="0 0 40 66" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={`${uid}-f`} cx="50%" cy="60%" r="65%">
      <stop offset="0" stop-color="#fff6dc" />
      <stop offset=".45" stop-color="#fbc661" />
      <stop offset="1" stop-color="#a85600" />
    </radialGradient>
  </defs>
  <circle cx="20" cy="4" r="3" fill="none" stroke="#fbc661" stroke-width="1.5" />
  <path d="M20 8c-2 5-12 8-14 16h28c-2-8-12-11-14-16z" fill="#184456" stroke="#f4ae3a" stroke-width="1" />
  <path d="M5 24h30v4H5z" fill="#f4ae3a" />
  <path d="M8 28h24v24H8z" fill="#0e2b3d" stroke="#8a5a12" stroke-width="1" />
  <path class="lantern-glow" d="M13 36a7 7 0 0 1 14 0v14H13z" fill={`url(#${uid}-f)`} />
  <path d="M6 52h28l-4 6H10z" fill="#f4ae3a" />
  <path d="M15 58h10l-2 4h-6z" fill="#8a5a12" />
</svg>
