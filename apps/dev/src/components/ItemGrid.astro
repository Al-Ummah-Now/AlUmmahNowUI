---
/** Facts with a status label. The label comes only from the wiki's feature registry. */
import type { Item, Strings } from '../i18n';
import { feature } from '../lib/registry';
import StatusChip from './StatusChip.astro';
interface Props {
  items: Item[];
  t: Strings;
  cols?: 2 | 3;
}
const { items: all, t, cols = 2 } = Astro.props;
// the site shows only what exists and runs today: a feature still being built, planned or rolling out stays off the page
const items = all.filter((i) => !i.feature || ['live', 'ready'].includes(feature(i.feature).status));
---
<ul class={`tiles tiles-${cols}`} role="list">
  {items.map((item) => (
    <li class="tile">
      <div class="tile-head">
        <h3 class="tile-title">{item.title}</h3>
        {item.feature && <StatusChip status={feature(item.feature).status} label={t.status[feature(item.feature).status as 'live' | 'ready']} />}
      </div>
      <p class="tile-body">{item.body}</p>
    </li>
  ))}
</ul>
