---
/** Facts with a status label and their sources. The label comes only from the wiki's feature registry. */
import type { Item, Strings } from '../i18n';
import { feature } from '../lib/registry';
import StatusChip from './StatusChip.astro';
import Sources from './Sources.astro';
interface Props {
  items: Item[];
  t: Strings;
  cols?: 2 | 3;
}
const { items, t, cols = 2 } = Astro.props;
---
<ul class={`tiles tiles-${cols}`} role="list">
  {items.map((item) => (
    <li class="tile">
      <div class="tile-head">
        <h3 class="tile-title">{item.title}</h3>
        {item.feature && <StatusChip status={feature(item.feature).status} label={t.status[feature(item.feature).status]} />}
      </div>
      <p class="tile-body">{item.body}</p>
      <Sources links={item.sources} label={t.common.source} plural={t.common.sources} />
    </li>
  ))}
</ul>
