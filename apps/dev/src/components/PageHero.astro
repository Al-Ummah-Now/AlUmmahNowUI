---
/** The night band at the top of every inner page: title and lead. */
import Rich from './Rich.astro';
interface Props {
  title: string;
  lead: string;
  /** a System design page: the text lines up with the column beside the section nav */
  section?: boolean;
}
const { title, lead, section = false } = Astro.props;
---
<section class:list={['page-hero night', section && 'page-hero-sd']} aria-labelledby="page-title">
  <div class="wrap">
    <div class="page-hero-text">
      <h1 id="page-title" class="display">{title}</h1>
      <p class="lead"><Rich text={lead} /></p>
      <slot />
    </div>
  </div>
</section>
