---
/** The night band at the top of every inner page: title and lead. */
import Rich from './Rich.astro';
interface Props {
  title: string;
  lead: string;
}
const { title, lead } = Astro.props;
---
<section class="page-hero night" aria-labelledby="page-title">
  <div class="wrap">
    <div class="page-hero-text">
      <h1 id="page-title" class="display">{title}</h1>
      <p class="lead"><Rich text={lead} /></p>
      <slot />
    </div>
  </div>
</section>
