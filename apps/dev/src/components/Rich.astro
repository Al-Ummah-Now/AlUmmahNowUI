---
/**
 * A sentence with inline links: `[label](https://…)` becomes a link, everything else stays text.
 * For the few places a developer would click through to a repo or a doc page; never a citation list.
 * In Arabic, every Latin run (a name, a path, an identifier) is isolated in a <bdi> kept on one line, so the
 * bidi algorithm never reorders it or its punctuation, and «api-videos» never breaks at its hyphen.
 */
import { splitLatin } from '../lib/arch/text.ts';
interface Props {
  text: string;
}
const { text } = Astro.props;
const parts: ({ t: string } | { label: string; href: string })[] = [];
const re = /\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g;
let last = 0;
for (const m of text.matchAll(re)) {
  if (m.index! > last) parts.push({ t: text.slice(last, m.index) });
  parts.push({ label: m[1]!, href: m[2]! });
  last = m.index! + m[0].length;
}
if (last < text.length) parts.push({ t: text.slice(last) });
// a long path («/priv/<token>/<videoId>/…») may break after its slashes on a narrow card, never inside a piece
const pathPieces = (run: string): string[] | null => {
  if (run.length < 22 || !run.includes('/')) return null;
  const pieces = run.split(/(?<=\/)/).filter(Boolean);
  return pieces.length > 1 ? pieces : null;
};
---
{parts.map((p) =>
  't' in p ? (
    splitLatin(p.t).map((q) =>
      !q.latin ? (
        q.t
      ) : pathPieces(q.t) ? (
        <bdi dir="ltr" class="lr lr-path">{pathPieces(q.t)!.map((piece, i) => (i ? [<wbr />, <span>{piece}</span>] : <span>{piece}</span>))}</bdi>
      ) : (
        <bdi dir="ltr" class="lr">{q.t}</bdi>
      ),
    )
  ) : (
    <a href={p.href} rel="external">{p.label}</a>
  ),
)}
