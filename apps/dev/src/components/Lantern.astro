---
/**
 * The hero lantern: a six-sided fanous seen from the front, its windows filled with the eight-point
 * star of the brand pattern (public/brand/pattern.svg) and lit from inside. Drawn, not a photo, so it is
 * sharp at any size, weighs a few KB and its light can follow the theme tokens.
 * An empty `label` makes it decorative (aria-hidden). `uid` keeps gradient ids unique when more than one lantern is on a page.
 */
interface Props {
  label: string;
  uid?: string;
  class?: string;
}
const { label, uid = 'l', class: className } = Astro.props;
const id = (s: string) => `${uid}-${s}`;
---
<svg class:list={['lantern', className]} viewBox="0 0 240 420" role={label ? 'img' : undefined} aria-label={label || undefined} aria-hidden={label ? undefined : 'true'} focusable="false">
  <defs>
    <radialGradient id={id('halo')} cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#fbc661" stop-opacity=".55" />
      <stop offset=".35" stop-color="#f4ae3a" stop-opacity=".22" />
      <stop offset="1" stop-color="#f4ae3a" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={id('fire')} cx="50%" cy="58%" r="60%">
      <stop offset="0" stop-color="#fff6dc" />
      <stop offset=".3" stop-color="#ffd98a" />
      <stop offset=".7" stop-color="#f4ae3a" />
      <stop offset="1" stop-color="#a85600" />
    </radialGradient>
    <linearGradient id={id('metal')} x1="0" x2="1">
      <stop offset="0" stop-color="#0b1d2a" />
      <stop offset=".45" stop-color="#184456" />
      <stop offset=".55" stop-color="#1d5068" />
      <stop offset="1" stop-color="#0b1d2a" />
    </linearGradient>
    <linearGradient id={id('gold')} x1="0" x2="1">
      <stop offset="0" stop-color="#8a5a12" />
      <stop offset=".5" stop-color="#fbc661" />
      <stop offset="1" stop-color="#8a5a12" />
    </linearGradient>
    <linearGradient id={id('side')} x1="0" x2="1">
      <stop offset="0" stop-color="#a85600" stop-opacity=".9" />
      <stop offset="1" stop-color="#f4ae3a" />
    </linearGradient>
    <!-- The brand's eight-point star: two squares, one turned 45° -->
    <pattern id={id('star')} width="18" height="18" patternUnits="userSpaceOnUse">
      <g fill="none" stroke="#0b1d2a" stroke-width="1.6" stroke-linejoin="round">
        <path d="M5.5 5.5h7v7h-7z" />
        <path d="M9 4.05 13.95 9 9 13.95 4.05 9z" />
        <path d="M0 9h4M14 9h4M9 0v4M9 14v4" />
      </g>
    </pattern>
    <clipPath id={id('front')}><path d="M90 168a30 30 0 0 1 60 0v124H90z" /></clipPath>
    <clipPath id={id('left')}><path d="M60 178q8-22 22-26v148l-22-8z" /></clipPath>
    <clipPath id={id('right')}><path d="M180 178q-8-22-22-26v148l22-8z" /></clipPath>
  </defs>

  <circle class="lantern-halo" cx="120" cy="240" r="150" fill={`url(#${id('halo')})`} />

  <!-- Cable and ring -->
  <path d="M120 0v44" stroke={`url(#${id('gold')})`} stroke-width="2.5" />
  <circle cx="120" cy="50" r="7" fill="none" stroke="#fbc661" stroke-width="2.5" />
  <!-- Finial and dome -->
  <circle cx="120" cy="66" r="6" fill={`url(#${id('gold')})`} />
  <path d="M120 72c-6 14-38 24-46 56h92c-8-32-40-42-46-56z" fill={`url(#${id('metal')})`} stroke="#f4ae3a" stroke-width="1.5" />
  <path d="M86 116c10-20 26-28 34-40 8 12 24 20 34 40" fill="none" stroke="#fbc661" stroke-opacity=".55" stroke-width="1" />
  <!-- Crown band -->
  <path d="M56 128h128l-6 14H62z" fill={`url(#${id('gold')})`} />
  <path d="M62 142h116v8H62z" fill="#0b1d2a" />

  <!-- Body: side panels in perspective, front panel straight -->
  <path d="M52 150h36v160H52l-6-8V158z" fill={`url(#${id('metal')})`} stroke="#8a5a12" stroke-width="1.2" />
  <path d="M188 150h-36v160h36l6-8V158z" fill={`url(#${id('metal')})`} stroke="#8a5a12" stroke-width="1.2" />
  <path d="M84 150h72v160H84z" fill={`url(#${id('metal')})`} stroke="#f4ae3a" stroke-width="1.4" />

  <!-- Lit windows -->
  <g class="lantern-glow">
    <g clip-path={`url(#${id('front')})`}>
      <rect x="84" y="130" width="72" height="170" fill={`url(#${id('fire')})`} />
      <rect x="84" y="130" width="72" height="170" fill={`url(#${id('star')})`} />
    </g>
    <g clip-path={`url(#${id('left')})`} opacity=".8">
      <rect x="56" y="140" width="30" height="170" fill={`url(#${id('side')})`} />
      <rect x="56" y="140" width="30" height="170" fill={`url(#${id('star')})`} />
    </g>
    <g clip-path={`url(#${id('right')})`} opacity=".8">
      <rect x="154" y="140" width="30" height="170" fill={`url(#${id('side')})`} transform="matrix(-1 0 0 1 338 0)" />
      <rect x="154" y="140" width="30" height="170" fill={`url(#${id('star')})`} />
    </g>
  </g>
  <path d="M90 168a30 30 0 0 1 60 0v124H90z" fill="none" stroke="#fbc661" stroke-width="2" />

  <!-- Base -->
  <path d="M44 310h152l-8 12H52z" fill={`url(#${id('gold')})`} />
  <path d="M60 322h120l-14 22H74z" fill={`url(#${id('metal')})`} stroke="#8a5a12" stroke-width="1.2" />
  <path d="M96 344h48l-6 10h-36z" fill={`url(#${id('gold')})`} />
  <ellipse cx="120" cy="404" rx="70" ry="8" fill="#f4ae3a" opacity=".12" />
</svg>
