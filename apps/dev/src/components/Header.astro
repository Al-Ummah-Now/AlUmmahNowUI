---
import ThemeIcon from '../../../www/src/components/ThemeIcon.astro';
import type { Strings } from '../i18n';
import { PAGES, otherLocale, pagePath, type Locale, type PageSlug } from '../lib/pages';
interface Props {
  locale: Locale;
  slug: PageSlug;
  t: Strings;
}
const { locale, slug, t } = Astro.props;
const other = otherLocale(locale);
const label = (p: PageSlug) => (p === '' ? t.nav.home : t.nav[p]);
---
<header class="site-header">
  <div class="wrap header-row">
    {/* The brand exactly as www's Header.astro shows it: the real logo and the name, no lockup */}
    <a class="brand" href={pagePath(locale, '')} aria-label={t.a11y.home}>
      <img src="/brand/logo-192.webp" alt="" width="40" height="40" />
      {locale === 'ar' ? <span class="brand-ar">الأمة الآن</span> : <span>Al Ummah Now</span>}
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="menu-bars" aria-hidden="true"></span>{t.nav.menu}
    </button>
    <nav id="site-nav" class="site-nav" aria-label={t.nav.primary}>
      <ul role="list">
        {PAGES.filter((p) => p !== '').map((p) => (
          <li><a href={pagePath(locale, p)} aria-current={p === slug ? 'page' : undefined}>{label(p)}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-tools">
      <a class="lang-link" href={pagePath(other, slug)} hreflang={other} lang={other}>{t.nav.language}</a>
      <button class="mode-toggle" type="button" aria-pressed="false" data-mode-toggle>
        <ThemeIcon mode="dark" />
        <span>{t.nav.toDark}</span>
      </button>
    </div>
  </div>
</header>
