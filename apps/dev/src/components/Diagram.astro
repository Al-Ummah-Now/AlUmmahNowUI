---
/**
 * Renders a DiagramSpec as inline SVG. Desktop and phone variants are two SVGs of the same spec
 * builder; CSS (site.css .dg-wide / .dg-narrow) shows one per viewport, and the hidden one is
 * removed from the a11y tree by display:none. Arabic: every x is mirrored (src/lib/diagram.ts),
 * <text> keeps its own direction, so the composition flips and the words stay readable.
 *
 * Node silhouettes: databases draw as cylinders, queues as pipes; every node may carry a small
 * icon drawn from theme tokens (never text, so nothing is "baked in" for screen readers — the
 * accessible name stays the svg title/desc and the page copy). Zones carry a header band.
 */
import {
  boxX,
  edgeLabelAt,
  edgePath,
  pointX,
  wrap,
  type DiagramEdge,
  type DiagramNode,
  type DiagramSpec,
  type IconKind,
} from '../lib/diagram.ts';

interface Props {
  spec: DiagramSpec;
  rtl: boolean;
  variant: 'wide' | 'narrow';
  className?: string;
}
const { spec, rtl, variant, className = '' } = Astro.props;

const ICON: Record<IconKind, string> = {
  person: 'M7 5.5a2.2 2.2 0 1 0 0.01 0M2.8 13c.6-2.6 2.3-4 4.7-4s4.1 1.4 4.7 4',
  browser: 'M1.5 2.5h13v10h-13zM1.5 5h13M3 3.7h.01M4.4 3.7h.01',
  device: 'M4.5 1.5h6a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-10a1 1 0 0 1 1-1zM6.2 11.6h2.6',
  cloud: 'M4.4 11.5a2.9 2.9 0 0 1-.3-5.8 3.8 3.8 0 0 1 7.3.9 2.6 2.6 0 0 1-.6 4.9zM5 11.5h6.8',
  shield: 'M7.5 1.6 3 3.2v3.9c0 2.7 1.9 4.6 4.5 5.5 2.6-.9 4.5-2.8 4.5-5.5V3.2zM7.5 7l-1.4 1.4M7.5 7l1.4 1.4M7.5 7v2.6',
  worker: 'M3 3.2 7 7 3 10.8M7.5 11h4M7.5 7h4M7.5 3h4',
  film: 'M1.8 2.5h11.4v9H1.8zM4 2.5v9M11 2.5v9M1.8 5.2h2.2M1.8 8.8h2.2M11 5.2h2.2M11 8.8h2.2',
  gear: 'M7.5 5.9a1.6 1.6 0 1 0 .01 0M7.5 1.8v1.6M7.5 11.6v1.6M2.3 7.5h1.6M11.1 7.5h1.6M3.8 3.8l1.1 1.1M10.1 10.1l1.1 1.1M11.2 3.8l-1.1 1.1M4.9 10.1l-1.1 1.1',
  chart: 'M2.2 12.8V2.6M2.2 12.8h10.6M4.6 11V8.2M7.5 11V5.9M10.4 11V7',
  pulse: 'M1.6 7.5h2.6l1.6-4 2.6 8 1.7-4h2.3',
  db: 'M2.8 3.4c0-1 2.1-1.8 4.7-1.8s4.7.8 4.7 1.8-2.1 1.8-4.7 1.8-4.7-.8-4.7-1.8zM2.8 3.4v7.2c0 1 2.1 1.8 4.7 1.8s4.7-.8 4.7-1.8V3.4M2.8 7c0 1 2.1 1.8 4.7 1.8s4.7-.8 4.7-1.8',
  kv: 'M10.2 4.3a2.7 2.7 0 1 0 .01 0M8.4 6.1 2.6 11.9M3.4 9.9l1.3 1.3M5 8.3l1.3 1.3',
  bucket: 'M3.2 4.8h8.6l-1 8a1 1 0 0 1-1 .9H5.2a1 1 0 0 1-1-.9zM2.4 4.8h10.2M5.6 2.4a2.1 2.1 0 0 1 3.8 0',
  queue: 'M1.6 3h12.8M1.6 7.5h12.8M1.6 12h12.8M4 1.7v11.6M11 1.7v11.6',
  do: 'M7.5 1.7a5.8 5.8 0 1 0 .01 0M7.5 4.5 10.3 6.1v3.2L7.5 10.9 4.7 9.3V6.1zM7.5 4.5v6.4',
  globe: 'M7.5 1.7a5.8 5.8 0 1 0 .01 0M1.7 7.5h11.6M7.5 1.7c-3.6 3.7-3.6 8 0 11.6 3.6-3.6 3.6-7.9 0-11.6',
  book: 'M2.2 3c1.8-.9 3.6-.9 5.3.2 1.7-1.1 3.5-1.1 5.3-.2v9.3c-1.8-.9-3.6-.9-5.3.2-1.7-1.1-3.5-1.1-5.3-.2zM7.5 3.2v9.3',
  ai: 'M7.5 1.6 8.7 6.3 13.4 7.5 8.7 8.7 7.5 13.4 6.3 8.7 1.6 7.5 6.3 6.3zM12.4 2.2l.4 1.3M12.8 3.5l1.3.4',
  mail: 'M1.8 3.4h11.4v8.2H1.8zM1.8 3.9l5.7 4.3 5.7-4.3',
  bell: 'M7.5 2a3.4 3.4 0 0 1 3.4 3.4c0 3 1.1 4 1.1 4H3s1.1-1 1.1-4A3.4 3.4 0 0 1 7.5 2M6.1 11.6a1.5 1.5 0 0 0 2.8 0',
  play: 'M2.4 2.6h9.2a1 1 0 0 1 1 1v7.8a1 1 0 0 1-1 1H2.4a1 1 0 0 1-1-1V3.6a1 1 0 0 1 1-1M6.3 5.6l3 1.9-3 1.9z',
  upload: 'M7.5 10.4V2.6M4.6 5.5 7.5 2.6l2.9 2.9M2.4 12.8h10.2',
  link: 'M6.1 8.9 8.9 6.1M5 6.9 3.6 5.5a2.1 2.1 0 0 1 3-3L8 3.9M10 8.1l1.4 1.4a2.1 2.1 0 0 1-3 3L7 11.1',
  lock: 'M4 6.6V5a3.5 3.5 0 0 1 7 0v1.6M3.2 6.6h8.6v6.2H3.2zM7.5 8.9v1.7',
  container: 'M2.6 5.2 7.5 2.6l4.9 2.6-4.9 2.6zM2.6 5.2v5.6l4.9 2.6 4.9-2.6V5.2M7.5 7.8v5.6M2.6 5.2l4.9 2.6 4.9-2.6',
  search: 'M6.7 1.9a4.4 4.4 0 1 0 .01 0M10 10l3.4 3.4',
};

const zoneBand = (x: number, y: number, w: number) =>
  `M ${x + 1} ${y + 30} L ${x + 1} ${y + 18} Q ${x + 1} ${y + 1} ${x + 18} ${y + 1} L ${x + w - 18} ${y + 1} Q ${x + w - 1} ${y + 1} ${x + w - 1} ${y + 18} L ${x + w - 1} ${y + 30} Z`;

const cylinder = (x: number, y: number, w: number, h: number, ry: number) => ({
  top: `M ${x + 3} ${y + ry} a ${(w - 6) / 2} ${ry} 0 1 0 ${w - 6} 0 a ${(w - 6) / 2} ${ry} 0 1 0 -${w - 6} 0`,
  body: `M ${x + 3} ${y + ry} v ${h - ry * 2} a ${(w - 6) / 2} ${ry} 0 0 0 ${w - 6} 0 v -${h - ry * 2}`,
});

const nodeLines = (node: DiagramNode) => {
  const title = wrap(node.title, node.w > 240 ? 34 : 26);
  const sub = (node.sub ?? []).flatMap((s) => wrap(s, node.w > 240 ? 40 : 30));
  const all = [...title.map((t) => ({ t, sub: false })), ...sub.map((t) => ({ t, sub: true }))];
  const line = node.h >= 64 ? 15 : 14;
  const start = node.y + node.h / 2 - ((all.length - 1) * line) / 2 + 4.5;
  return all.map((l, i) => ({ ...l, y: start + i * line }));
};
const edgeLabelLines = (e: DiagramEdge) => (e.label ? wrap(e.label, 22) : []);
---
<svg
  class={`dg dg-${variant} ${className}`}
  viewBox={`0 0 ${spec.width} ${spec.height}`}
  role="img"
  aria-labelledby={`${spec.id}-${variant}-title ${spec.id}-${variant}-desc`}
  preserveAspectRatio="xMidYMin meet"
>
  <title id={`${spec.id}-${variant}-title`}>{spec.title}</title>
  <desc id={`${spec.id}-${variant}-desc`}>{spec.desc}</desc>
  <defs>
    <marker id={`${spec.id}-${variant}-head`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="dg-head" d="M 0 1 L 9 5 L 0 9 z"></path>
    </marker>
    <marker id={`${spec.id}-${variant}-head-dashed`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="dg-head dg-head-quiet" d="M 0 1 L 9 5 L 0 9 z"></path>
    </marker>
  </defs>
  {spec.shapes.map((s) =>
    s.kind === 'zone' ? (
      <g>
        <rect class={`dg-zone dg-zone-${s.tone ?? 'default'}`} x={boxX(spec, rtl, s.x, s.w)} y={s.y} width={s.w} height={s.h} rx="18"></rect>
        <path class={`dg-zone-band dg-zone-band-${s.tone ?? 'default'}`} d={zoneBand(boxX(spec, rtl, s.x, s.w), s.y, s.w)}></path>
        <text class="dg-zone-label" x={boxX(spec, rtl, s.x, s.w) + s.w / 2} y={s.y + 20} text-anchor="middle">{s.label}</text>
      </g>
    ) : s.kind === 'node' ? (
      <g>
        {s.shape === 'cylinder' ? (
          <g>
            <path class={`dg-node dg-node-${s.tone ?? 'plain'}`} d={cylinder(boxX(spec, rtl, s.x, s.w), s.y, s.w, s.h, 8).body}></path>
            <ellipse class={`dg-node dg-node-${s.tone ?? 'plain'}`} cx={boxX(spec, rtl, s.x, s.w) + s.w / 2} cy={s.y + 8} rx={(s.w - 6) / 2} ry={8}></ellipse>
          </g>
        ) : s.shape === 'pipe' ? (
          <g>
            <rect class={`dg-node dg-node-${s.tone ?? 'plain'}`} x={boxX(spec, rtl, s.x, s.w)} y={s.y} width={s.w} height={s.h} rx={s.h / 2}></rect>
            <path class="dg-pipe-div" d={`M ${boxX(spec, rtl, s.x, s.w) + s.w / 3} ${s.y + 4} v ${s.h - 8} M ${boxX(spec, rtl, s.x, s.w) + (2 * s.w) / 3} ${s.y + 4} v ${s.h - 8}`}></path>
          </g>
        ) : (
          <rect class={`dg-node dg-node-${s.tone ?? 'plain'}`} x={boxX(spec, rtl, s.x, s.w)} y={s.y} width={s.w} height={s.h} rx="10"></rect>
        )}
        {s.icon && (
          <g class={`dg-ic${s.tone === 'ai' ? ' dg-ic-ai' : ''}`} transform={`translate(${boxX(spec, rtl, s.x, s.w) + (rtl ? s.w - 24 : 10)}, ${s.y + s.h / 2 - 7})`}>
            <path d={ICON[s.icon]}></path>
          </g>
        )}
        {nodeLines(s).map((l) => (
          <text
            class={l.sub ? 'dg-sub' : 'dg-title'}
            x={boxX(spec, rtl, s.x, s.w) + s.w / 2 + (s.icon ? (rtl ? -9 : 9) : 0)}
            y={l.y}
            text-anchor="middle">{l.t}</text>
        ))}
      </g>
    ) : (
      <g>
        <path
          class={`dg-edge${s.dashed ? ' dg-edge-dashed' : ''}`}
          d={edgePath(spec, rtl, s)}
          marker-end={`url(#${spec.id}-${variant}-head${s.dashed ? '-dashed' : ''})`}></path>
        {edgeLabelLines(s).map((line, i, arr) => {
          const at = s.labelAt ? { x: s.labelAt[0], y: s.labelAt[1] } : edgeLabelAt(s);
          const lineH = 13;
          const first = at.y - ((arr.length - 1) * lineH) / 2 + 4;
          const y = first + i * lineH;
          const w = Math.min(190, line.length * 6.2 + 16);
          return (
            <g>
              <rect class="dg-edge-label-bg" x={pointX(spec, rtl, at.x) - w / 2} y={y - 10} width={w} height={lineH + 3} rx="8"></rect>
              <text class="dg-edge-label" x={pointX(spec, rtl, at.x)} y={y} text-anchor="middle">{line}</text>
            </g>
          );
        })}
      </g>
    )
  )}
</svg>
