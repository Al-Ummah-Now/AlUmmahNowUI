---
/** A short ordered sequence (release, contributing): numerals on a rule, no lanterns. */
interface Props {
  steps: { title: string; body: string }[];
  label: string;
}
const { steps, label } = Astro.props;
---
<ol class="steps" aria-label={label}>
  {steps.map((s, i) => (
    <li class="step">
      <span class="step-n" aria-hidden="true">{i + 1}</span>
      <h3 class="step-title">{s.title}</h3>
      <p class="step-body">{s.body}</p>
    </li>
  ))}
</ol>
