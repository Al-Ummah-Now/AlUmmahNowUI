---
/**
 * One system design diagram (src/lib/arch): the wide layout for desktops, the stacked layout for
 * phones (CSS picks one), a heading, and a legend naming only the flow types this diagram uses.
 * `costs` adds the example picker and the comparison bars; any diagram with cost meters is driven by
 * src/scripts/meters.ts (final totals with reduced motion).
 */
import '../styles/arch.css';
import { diagram, type DiagramId } from '../lib/arch/all';
import { laneTotals, scenarioLabels } from '../lib/arch/specs/costs';
import { formatUsd } from '../lib/arch/cost';
import { fill, formatNumber } from '../../../../packages/render/src/format.ts';
import { strings } from '../i18n';
import Rich from './Rich.astro';
import type { Locale } from '../lib/pages';

interface Props {
  id: DiagramId;
  locale: Locale;
  title?: string;
  lead?: string;
  bleed?: boolean;
  headingId?: string;
  /** show the example picker and the per-pipeline comparison */
  costs?: boolean;
  /** for developers, under the figure: why it is built this way, and what that costs */
  why?: string;
  tradeoff?: string;
}
const { id, locale, title, lead, bleed = true, headingId, costs = false, why, tradeoff } = Astro.props;
const d = diagram(id, locale);
const dg = strings(locale).diagrams;
const lg = dg.legend;
const flows = d.flows as (keyof typeof lg)[];
const totals = laneTotals();
/** each lane's total in the example shown without script */
const first = (lane: keyof typeof totals) => totals[lane].one ?? 0;
const most = Math.max(first('bunny'), first('r2'), first('shared'), 1e-9);
const compareRows = [
  { lane: 'bunny', label: dg.costs.lane.bunny },
  { lane: 'r2', label: dg.costs.lane.r2 },
  { lane: 'shared', label: dg.costs.lane.shared },
] as const;
const uid = `${id}-${headingId ?? 'fig'}`;
const svgTitle = /<title[^>]*>([^<]+)<\/title>/.exec(d.wide)?.[1] ?? '';
const diagramTitle = title ?? svgTitle;
const expandAriaLabel = fill(dg.viewer.expandDiagram, { title: diagramTitle || dg.viewer.viewerLabel }, locale);
---
<figure class="an-figure" aria-labelledby={headingId} data-unknown-label={dg.costs.unknown} data-diagram-title={diagramTitle} data-viewer-i18n={JSON.stringify(dg.viewer)}>
  {title && <h2 id={headingId} class="h2">{title}</h2>}
  {lead && <p class="section-lead"><Rich text={lead} /></p>}
  {costs && (
    <fieldset class="an-scenarios">
      <legend>{dg.costs.pick}</legend>
      {scenarioLabels(dg.costs, locale).map((s, i) => (
        <label class="an-scenario">
          <input type="radio" name="an-scenario" value={s.id} checked={i === 0} id={`${uid}-${s.id}`} />
          {/* each value («٢٠ ساعة مرفوعة»، "2,000 viewer-hours") stays on one line: the label breaks only between them */}
          <span>{s.label.split(/(?<=[،,:؛])\s+/).map((part, k) => (<>{k > 0 && ' '}<span class="an-nw">{part}</span></>))}</span>
        </label>
      ))}
    </fieldset>
  )}
  {/* the key above the figure: a tall drawing is read top to bottom, so the reader knows the lines first */}
  {[['an-legend-wide', (d.flowsWide ?? flows) as (keyof typeof lg)[]], ['an-legend-narrow', (d.flowsNarrow ?? flows) as (keyof typeof lg)[]]].map(([cls, fl]) => (
    ((fl as string[]).length > 0 || d.steps) && (
      <ul class={`an-legend an-legend-wrap ${cls}`} aria-label={lg.title}>
        {(fl as (keyof typeof lg)[]).map((f) => (
          <li><span class:list={['an-sw', `an-sw-f-${f}`, f === 'control' && 'an-sw-dash']} aria-hidden="true" />{lg[f]}</li>
        ))}
        {d.steps && id !== 'costs' && <li><span class="an-sw an-sw-step" aria-hidden="true">{formatNumber(1, locale)}</span>{lg.steps}</li>}
        {d.lifelines && <li><span class="an-sw an-sw-life" aria-hidden="true" />{lg.lifeline}</li>}
      </ul>
    )
  ))}
  <div class:list={['an-frame', bleed && 'an-bleed']}>
    <div class="an-frame-bar">
      <button type="button" class="an-expand-btn" data-diagram-expand aria-label={expandAriaLabel} title={expandAriaLabel}>
        <svg class="an-btn-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 3 21 3 21 9" />
          <polyline points="9 21 3 21 3 15" />
          <line x1="21" y1="3" x2="14" y2="10" />
          <line x1="3" y1="21" x2="10" y2="14" />
        </svg>
        <span>{dg.viewer.expand}</span>
      </button>
    </div>
    <div class="an-wide an-diagram-surface" set:html={d.wide} />
    <div class="an-narrow an-diagram-surface" set:html={d.narrow} />
  </div>
  {costs && (
    <section class="an-compare an-legend-wrap" aria-label={dg.costs.compare}>
      <h3 class="an-compare-title">{dg.costs.compare}</h3>
      <ul role="list">
        {compareRows.map((row) => (
          <li class={`an-compare-row an-compare-${row.lane}`} data-compare={row.lane} data-usd={JSON.stringify(totals[row.lane])} >
            <span class="an-compare-label">{row.label}</span>
            <progress class="an-compare-bar" max="1000" value={Math.round((first(row.lane) / most) * 1000)} aria-hidden="true" />
            <output>{formatUsd(locale, first(row.lane))}</output>
          </li>
        ))}
      </ul>
      <p class="an-compare-note">{dg.costs.note}</p>
    </section>
  )}
  {(why || tradeoff) && (
    <div class="an-notes-text">
      {why && <p><strong>{dg.why}</strong> <Rich text={why} /></p>}
      {tradeoff && <p><strong>{dg.tradeoff}</strong> <Rich text={tradeoff} /></p>}
    </div>
  )}
</figure>
<script>
  import '../scripts/meters.ts';
  import '../scripts/diagram-viewer.ts';
</script>
