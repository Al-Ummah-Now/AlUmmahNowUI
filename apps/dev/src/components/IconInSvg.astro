---
/**
 * A vendored icon placed inside a diagram's <svg>: the brand's own vector embedded as a nested
 * <svg>, scaled only (docs/ICONS.md). Vendor marks are coloured by the .icv-<vendor> classes in
 * site.css; Lucide glyphs follow the text colour.
 */
import { iconParts, iconStyle, type IconId } from '../lib/icons.ts';

interface Props {
  id: IconId;
  x: number;
  y: number;
  size?: number;
}
const { id, x, y, size = 44 } = Astro.props;
const { viewBox, inner } = iconParts(id);
const vendor = id.split('/')[0];
const st = iconStyle(id, size);
const iw = size;
const ih = size;
---
<svg class={`icv icv-${vendor} ${st.class}`} style={`${st.style};width:${iw}px;height:${ih}px`} x={x - iw / 2} y={y} width={iw} height={ih} viewBox={viewBox} preserveAspectRatio="xMidYMid meet" overflow="visible" set:html={inner} />
