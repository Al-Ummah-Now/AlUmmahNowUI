---
/**
 * Renders a RefSpec in the reference-architecture style (style sample 5): services are their
 * real vendored icon on a small card with the label under it, a dashed platform boundary, thin
 * solid groups with title + caption, solid traffic arrows and dashed control arrows with small
 * labels — plus the owner's animated data flow:
 *   (a) glowing pulse dots travelling each wire (animateMotion + mpath, 2 staggered dots,
 *       negative begin), cyan for requests, gold for upload/processing, green for responses;
 *   (b) a marching-light overlay on steady streams (dasharray 6 14, dashoffset animation,
 *       gaussian glow);
 *   (c) numbered step badges whose pulse fires hop by hop (keyPoints/keyTimes + opacity).
 * Under prefers-reduced-motion the moving parts are hidden (CSS) and the static arrows,
 * numbers and labels stay. Light mode is the sample's white canvas; dark mode is the same
 * drawing with inverted lines and text — brand icons unchanged.
 */
import IconInSvg from '../IconInSvg.astro';
import { refBoxX, refEdgeLabelAt, refEdgePath, refPointX, type RefEdge, type RefSpec } from '../../lib/reference.ts';
import type { IconId } from '../../lib/icons.ts';

interface Props {
  spec: RefSpec;
  rtl: boolean;
  variant: 'wide' | 'narrow';
  legend?: { request: string; upload: string; response: string; control: string } | null;
}
const { spec, rtl, variant, legend } = Astro.props;
const pathId = (e: RefEdge, i: number) => `${spec.id}-${variant}-w-${e.id}-${i}`;
const flowClass = (e: RefEdge) => (e.dashed ? 'rf-flow-control' : `rf-flow-${e.flow ?? 'request'}`);
---
<svg
  class={`rf rf-${variant}`}
  viewBox={`0 0 ${spec.width} ${spec.height}`}
  role="img"
  aria-labelledby={`${spec.id}-${variant}-title ${spec.id}-${variant}-desc`}
  preserveAspectRatio="xMidYMin meet"
>
  <title id={`${spec.id}-${variant}-title`}>{spec.title}</title>
  <desc id={`${spec.id}-${variant}-desc`}>{spec.desc}</desc>
  <defs>
    <marker id={`${spec.id}-${variant}-ah`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7.5" markerHeight="7.5" orient="auto-start-reverse">
      <path d="M 0 1 L 9 5 L 0 9 z" class="rf-head"></path>
    </marker>
    <filter id={`${spec.id}-${variant}-glow`} x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="2.2" result="b"></feGaussianBlur>
      <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
    </filter>
  </defs>

  {spec.shapes.map((s) =>
    s.kind === 'boundary' ? (
      <g>
        <rect class="rf-boundary" x={refBoxX(spec, rtl, s.x, s.w)} y={s.y} width={s.w} height={s.h} rx="14"></rect>
        <IconInSvg id="simple-icons/cloudflare" x={refBoxX(spec, rtl, s.x, s.w) + s.w / 2 + (rtl ? -1 : 1) * Math.min(190, s.w / 2 - 60)} y={variant === 'narrow' ? s.y + s.h - 40 : s.y - 36} size={24} />
        <text class={`rf-boundary-label${variant === 'narrow' ? ' rf-boundary-label-narrow' : ''}`} x={refBoxX(spec, rtl, s.x, s.w) + s.w / 2} y={variant === 'narrow' ? s.y + s.h - 12 : s.y - 12} text-anchor="middle">{s.label}</text>
      </g>
    ) : s.kind === 'group' ? (
      <g>
        <rect class="rf-group" x={refBoxX(spec, rtl, s.x, s.w)} y={s.y} width={s.w} height={s.h}></rect>
        <text class="rf-group-title" x={refBoxX(spec, rtl, s.x, s.w) + s.w / 2} y={s.y + 20} text-anchor="middle">{s.title}</text>
        {s.caption && <text class="rf-group-caption" x={refBoxX(spec, rtl, s.x, s.w) + s.w / 2} y={s.y + s.h - 8} text-anchor="middle">{s.caption}</text>}
      </g>
    ) : s.kind === 'heading' ? (
      <text class="rf-heading" x={refPointX(spec, rtl, s.x + 90)} y={s.y} text-anchor="middle">{s.text}</text>
    ) : s.kind === 'service' ? (
      <g>
        <rect class="rf-card" x={refPointX(spec, rtl, s.x) - 34} y={s.y - 6} width="68" height={68 + s.name.length * 17 + 6} rx="10"></rect>
        <IconInSvg id={s.icon as IconId} x={refPointX(spec, rtl, s.x)} y={s.y + 2} size={variant === 'wide' ? 44 : 34} />
        {s.name.slice(0, variant === 'wide' ? 2 : 1).map((line, i) => (
          <text class="rf-name" x={refPointX(spec, rtl, s.x)} y={s.y + 62 + i * 17} text-anchor="middle">{line}</text>
        ))}
      </g>
    ) : (
      <g>
        <path id={pathId(s, 0)} class={`rf-edge${s.dashed ? ' rf-edge-dashed' : ''}`} d={refEdgePath(spec, rtl, s)} marker-end={`url(#${spec.id}-${variant}-ah)`}></path>
        {s.stream && <path class={`rf-stream ${flowClass(s)}`} d={refEdgePath(spec, rtl, s)}></path>}
        {s.step !== undefined && (
          <g>
            <circle class={`rf-step ${flowClass(s)}`} cx={refPointX(spec, rtl, s.from[0])} cy={s.from[1] - 14} r="11"></circle>
            <text class="rf-step-n" x={refPointX(spec, rtl, s.from[0])} y={s.from[1] - 9.5} text-anchor="middle">{s.step}</text>
          </g>
        )}
        {s.label && (
          <text class="rf-edge-label" x={refPointX(spec, rtl, refEdgeLabelAt(s).x)} y={refEdgeLabelAt(s).y + (s.beside === 'above' ? -8 : s.beside === 'below' ? 16 : 4)} text-anchor="middle">{s.label}</text>
        )}
        {!s.dashed && !s.stream && s.step === undefined && (
          <g class="rf-anim" filter={`url(#${spec.id}-${variant}-glow)`}>
            {[0, 1].map((i) => (
              <circle class={`rf-pulse ${flowClass(s)}`} r="4">
                <animateMotion dur={`${(s.durMs ?? 3200) / 1000}s`} repeatCount="indefinite" begin={`${-(i * ((s.durMs ?? 3200) / 2000))}s`}>
                  <mpath href={`#${pathId(s, 0)}`}></mpath>
                </animateMotion>
              </circle>
            ))}
          </g>
        )}
        {s.stream && (
          <g class="rf-anim" filter={`url(#${spec.id}-${variant}-glow)`}>
            <circle class={`rf-pulse ${flowClass(s)}`} r="4">
              <animateMotion dur={`${(s.durMs ?? 4200) / 1000}s`} repeatCount="indefinite" begin="-0.6s" keyPoints="0;1" keyTimes="0;1">
                <mpath href={`#${pathId(s, 0)}`}></mpath>
              </animateMotion>
            </circle>
          </g>
        )}
        {s.step !== undefined && (
          <g class="rf-anim" filter={`url(#${spec.id}-${variant}-glow)`}>
            <circle class={`rf-pulse ${flowClass(s)}`} r="4.5">
              <animateMotion dur={`${(s.durMs ?? 900) / 1000}s`} begin={`${(s.step - 1) * ((s.durMs ?? 900) / 1000)}s`} repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
                <mpath href={`#${pathId(s, 0)}`}></mpath>
              </animateMotion>
            </circle>
          </g>
        )}
      </g>
    )
  )}

  {legend && (
    <g class="rf-legend" transform={`translate(${rtl ? spec.width - 320 : 16}, 12)`}>
      {[
        ['rf-flow-request', legend.request],
        ['rf-flow-upload', legend.upload],
        ['rf-flow-response', legend.response],
        ['rf-flow-control', legend.control],
      ].map(([cls, text], i) => (
        <g transform={`translate(${rtl ? 300 - i * 78 : i * 78}, 0)`}>
          <circle class={`rf-pulse-static ${cls}`} cx="0" cy="0" r="4"></circle>
          <text class="rf-legend-text" x="8" y="3.5" text-anchor="start">{text}</text>
        </g>
      ))}
    </g>
  )}
</svg>
