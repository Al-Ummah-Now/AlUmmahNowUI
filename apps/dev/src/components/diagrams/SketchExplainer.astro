---
/**
 * A sketch-style explainer (style sample 1): hand-wobbly strokes via an SVG displacement
 * filter, pastel washes from theme tokens, doodle-style Lucide glyphs, and a scalloped cloud
 * boundary that wraps everything — "observability wraps it all". Used for friendly explainers;
 * this showcase one is "how a play is served". Two variants; Arabic mirrors.
 */
import { ICONS, iconStyle } from '../../lib/icons.ts';

interface Props {
  title: string;
  desc: string;
  rtl: boolean;
  labels: { cloud: string; person: string; watch: string; ask: string; choose: string; edge: string; play: string };
  variant: 'wide' | 'narrow';
}
const { title, desc, rtl, labels, variant } = Astro.props;
const W = variant === 'wide' ? 1200 : 360;
const H = variant === 'wide' ? 560 : 1000;
const x = (v: number) => (rtl ? W - v : v);
const uid = `sk-${variant}`;

const cloudPath = (w: number, h: number) => {
  // scalloped cloud boundary made of arcs
  const b = 26;
  let d = `M ${b + 10} ${h / 2}`;
  d += ` A ${b + 10} ${b + 14} 0 0 1 ${b + 4} ${h / 2 - b * 2.4}`;
  d += ` A ${b + 12} ${b + 14} 0 0 1 ${b + 40} ${b * 1.6}`;
  d += ` A ${b + 16} ${b + 12} 0 0 1 ${w / 2 - b * 2} ${b * 0.9}`;
  d += ` A ${b + 16} ${b + 12} 0 0 1 ${w / 2 + b * 2} ${b * 0.8}`;
  d += ` A ${b + 14} ${b + 12} 0 0 1 ${w - b * 2.4} ${b * 1.7}`;
  d += ` A ${b + 12} ${b + 14} 0 0 1 ${w - 12} ${h / 2 - b * 1.8}`;
  d += ` A ${b + 10} ${b + 16} 0 0 1 ${w - b} ${h / 2 + b * 1.6}`;
  d += ` A ${b + 12} ${b + 14} 0 0 1 ${w - b * 3.4} ${h - b * 1.7}`;
  d += ` A ${b + 14} ${b + 12} 0 0 1 ${w / 2 + b} ${h - b * 0.9}`;
  d += ` A ${b + 16} ${b + 12} 0 0 1 ${w / 2 - b * 3} ${h - b}`;
  d += ` A ${b + 14} ${b + 14} 0 0 1 ${b * 2.4} ${h - b * 1.9}`;
  d += ` A ${b + 12} ${b + 14} 0 0 1 ${b} ${h / 2 + b * 1.4}`;
  d += ' Z';
  return d;
};

const steps =
  variant === 'wide'
    ? [
        { icon: 'lucide/user', cx: 150, cy: 150, size: 40, label: labels.person, note: labels.watch, wash: 'a' },
        { icon: 'lucide/play', cx: 470, cy: 150, size: 36, label: labels.ask, note: '', wash: 'b' },
        { icon: 'lucide/key-round', cx: 780, cy: 150, size: 34, label: labels.choose, note: '', wash: 'c' },
        { icon: 'simple-icons/cloudflare', cx: 470, cy: 400, size: 36, label: labels.edge, note: '', wash: 'd' },
        { icon: 'lucide/browser', cx: 860, cy: 400, size: 38, label: labels.play, note: '', wash: 'a' },
      ]
    : [
        { icon: 'lucide/user', cx: 180, cy: 150, size: 38, label: labels.person, note: labels.watch, wash: 'a' },
        { icon: 'lucide/play', cx: 180, cy: 330, size: 34, label: labels.ask, note: '', wash: 'b' },
        { icon: 'lucide/key-round', cx: 180, cy: 510, size: 32, label: labels.choose, note: '', wash: 'c' },
        { icon: 'simple-icons/cloudflare', cx: 180, cy: 690, size: 34, label: labels.edge, note: '', wash: 'd' },
        { icon: 'lucide/browser', cx: 180, cy: 870, size: 36, label: labels.play, note: '', wash: 'a' },
      ];
const arrows =
  variant === 'wide'
    ? [`M ${x(196)} 150 Q ${x(300)} 118 ${x(410)} 148`, `M ${x(518)} 150 Q ${x(620)} 118 ${x(726)} 148`, `M ${x(784)} 190 Q ${x(690)} 300 ${x(500)} 368`, `M ${x(512)} 400 Q ${x(660)} 380 ${x(810)} 398`]
    : [`M ${x(180)} 190 L ${x(180)} 300`, `M ${x(180)} 370 L ${x(180)} 480`, `M ${x(180)} 550 L ${x(180)} 660`, `M ${x(180)} 730 L ${x(180)} 840`];
---
<svg class={`sk sk-${variant}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${uid}-t ${uid}-d`} preserveAspectRatio="xMidYMin meet">
  <title id={`${uid}-t`}>{title}</title>
  <desc id={`${uid}-d`}>{desc}</desc>
  <defs>
    <filter id={`${uid}-rough`}>
      <feTurbulence type="fractalNoise" baseFrequency="0.022" numOctaves="2" seed="7" result="n"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="3.2"></feDisplacementMap>
    </filter>
  </defs>
  <g filter={`url(#${uid}-rough)`}>
    <path class="sk-cloud" d={cloudPath(W, H)}></path>
    {steps.map((st) => (
      <g>
        <rect class={`sk-wash sk-wash-${st.wash}`} x={x(st.cx) - 92} y={st.cy - 74} width="184" height="148" rx="26"></rect>
      </g>
    ))}
    {arrows.map((d, i) => (
      <g>
        <path class="sk-arrow" d={d}></path>
        <path class="sk-arrow-head" d={i < 2 ? (variant === 'wide' ? `M ${x(410)} 148 l -14 -8 l 2 14 z` : `M ${x(180)} 300 l -8 -14 l 16 0 z`) : variant === 'wide' ? `M ${x(500)} 368 l -14 -6 l 8 12 z` : `M ${x(180)} 840 l -8 -14 l 16 0 z`}></path>
      </g>
    ))}
  </g>
  {steps.map((st) => {
    const ist = iconStyle(st.icon, st.size);
    return (
      <g>
        <g transform={`translate(${x(st.cx) - st.size / 2}, ${st.cy - st.size / 2})`}>
          <g class={ist.class} style={ist.style} set:html={ICONS[st.icon]}></g>
        </g>
        <text class="sk-label" x={x(st.cx)} y={st.cy + st.size / 2 + 30} text-anchor="middle">{st.label}</text>
        {st.note && <text class="sk-note" x={x(st.cx)} y={st.cy + st.size / 2 + 52} text-anchor="middle">{st.note}</text>}
      </g>
    );
  })}
  <text class="sk-cloud-label" x={x(W / 2)} y={H - 18} text-anchor="middle">{labels.cloud}</text>
</svg>
<style>
  .sk { width: 100%; height: auto; font-family: var(--font-sans); }
  html[lang='ar'] .sk { font-family: var(--font-arabic); }
  .sk-cloud { fill: color-mix(in srgb, var(--surface) 62%, transparent); stroke: var(--text); stroke-width: 2; }
  .sk-wash { fill: color-mix(in srgb, var(--gold) 14%, var(--surface)); stroke: var(--text); stroke-width: 1.8; stroke-dasharray: 160 14; }
  .sk-wash-b { fill: color-mix(in srgb, var(--link) 12%, var(--surface)); }
  .sk-wash-c { fill: color-mix(in srgb, var(--accent) 14%, var(--surface)); }
  .sk-wash-d { fill: color-mix(in srgb, var(--muted) 16%, var(--surface)); }
  .sk-arrow { fill: none; stroke: var(--text); stroke-width: 2.2; stroke-linecap: round; }
  .sk-arrow-head { fill: var(--text); }
  .sk-label { fill: var(--text); font-size: 15px; font-weight: 600; }
  .sk-narrow .sk-label { font-size: 12.5px; }
  .sk-note { fill: var(--muted); font-size: 12.5px; }
  .sk-cloud-label { fill: var(--muted); font-size: 13px; letter-spacing: 0.05em; }
</style>
