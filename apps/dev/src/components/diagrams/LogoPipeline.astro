---
/**
 * The logo step-by-step pipeline (style sample 3): left-to-right numbered steps carrying the
 * real product marks, with the owner's animated data flow — travelling pulse dots (gold, for
 * upload/processing), a marching-light stream (green, for the HLS response) and numbered hop
 * badges that fire in order. Dashed control lines stay still. Animations pause under
 * prefers-reduced-motion; arrows and numbers remain readable alone.
 */
import { ICONS, iconStyle } from '../../lib/icons.ts';

interface Props {
  title: string;
  desc: string;
  rtl: boolean;
  steps: { label: string; sub: string }[];
  variant: 'wide' | 'narrow';
}
const { title, desc, rtl, steps, variant } = Astro.props;
const wide = variant === 'wide';
const W = wide ? 1320 : 360;
const H = wide ? 560 : 1450;
const x = (v: number) => (rtl ? W - v : v);
const uid = 'lp';

interface Node { icon: string; cx: number; cy: number; size: number; name: string }
const nodes: Node[] = wide ? [
  { icon: 'lucide/user', cx: 100, cy: 170, size: 40, name: 'creator' },
  { icon: 'cloudflare/workers', cx: 320, cy: 170, size: 40, name: 'api-videos' },
  { icon: 'brand/bunny-stream', cx: 620, cy: 100, size: 40, name: 'Bunny Stream' },
  { icon: 'cloudflare/r2', cx: 620, cy: 250, size: 40, name: 'R2 originals' },
  { icon: 'cloudflare/queues', cx: 620, cy: 400, size: 36, name: 'queue' },
  { icon: 'cloudflare/workers', cx: 840, cy: 400, size: 36, name: 'media worker' },
  { icon: 'simple-icons/docker', cx: 1030, cy: 400, size: 36, name: 'container' },
  { icon: 'simple-icons/ffmpeg', cx: 1030, cy: 320, size: 26, name: '' },
  { icon: 'cloudflare/r2', cx: 1030, cy: 170, size: 40, name: 'R2 pub · priv' },
  { icon: 'simple-icons/cloudflare', cx: 1190, cy: 170, size: 40, name: 'CDN edge' },
  { icon: 'lucide/browser', cx: 1190, cy: 400, size: 40, name: 'player' },
] : [
  { icon: 'lucide/user', cx: 180, cy: 120, size: 36, name: 'creator' },
  { icon: 'cloudflare/workers', cx: 180, cy: 300, size: 36, name: 'api-videos' },
  { icon: 'brand/bunny-stream', cx: 96, cy: 470, size: 32, name: 'Bunny' },
  { icon: 'cloudflare/r2', cx: 264, cy: 470, size: 32, name: 'R2' },
  { icon: 'cloudflare/queues', cx: 264, cy: 640, size: 30, name: 'queue' },
  { icon: 'cloudflare/workers', cx: 264, cy: 810, size: 30, name: 'media' },
  { icon: 'simple-icons/docker', cx: 264, cy: 980, size: 30, name: 'FFmpeg' },
  { icon: 'cloudflare/r2', cx: 180, cy: 1160, size: 34, name: 'R2 pub' },
  { icon: 'simple-icons/cloudflare', cx: 180, cy: 1330, size: 34, name: 'CDN' },
];
interface Wire { id: string; d: string; flow: 'request' | 'upload' | 'response'; label?: string; step?: number; stream?: boolean }
const wire = (d: (X: (v: number) => number) => string): string => d(x);
const wires: Wire[] = wide ? [
  { id: 'w1', d: wire((X) => `M ${X(128)} 170 L ${X(284)} 170`), flow: 'request', step: 1, label: steps[0]?.label },
  { id: 'w2', d: wire((X) => `M ${X(348)} 170 L ${X(470)} 170 L ${X(470)} 100 L ${X(588)} 100`), flow: 'upload', step: 2, label: steps[1]?.label },
  { id: 'w3', d: wire((X) => `M ${X(348)} 170 L ${X(470)} 170 L ${X(470)} 250 L ${X(588)} 250`), flow: 'upload', step: 2 },
  { id: 'w4', d: wire((X) => `M ${X(638)} 250 L ${X(638)} 376`), flow: 'upload', step: 3, label: steps[3]?.label },
  { id: 'w5', d: wire((X) => `M ${X(656)} 400 L ${X(804)} 400`), flow: 'upload', step: 4 },
  { id: 'w6', d: wire((X) => `M ${X(864)} 400 L ${X(994)} 400`), flow: 'upload', step: 4 },
  { id: 'w7', d: wire((X) => `M ${X(1046)} 376 L ${X(1046)} 216`), flow: 'upload', step: 5, label: steps[4]?.label },
  { id: 'w8', d: wire((X) => `M ${X(1054)} 170 L ${X(1158)} 170`), flow: 'response', step: 6, stream: true },
  { id: 'w9', d: wire((X) => `M ${X(1190)} 216 L ${X(1190)} 376`), flow: 'response', step: 6, stream: true, label: steps[5]?.label },
] : [
  { id: 'w1', d: wire((X) => `M ${X(180)} 148 L ${X(180)} 264`), flow: 'request', step: 1, label: steps[0]?.label },
  { id: 'w2', d: wire((X) => `M ${X(152)} 300 L ${X(96)} 300 L ${X(96)} 440`), flow: 'upload', step: 2, label: steps[1]?.label },
  { id: 'w3', d: wire((X) => `M ${X(208)} 300 L ${X(264)} 300 L ${X(264)} 440`), flow: 'upload', step: 2 },
  { id: 'w4', d: wire((X) => `M ${X(264)} 506 L ${X(264)} 610`), flow: 'upload', step: 3, label: steps[3]?.label },
  { id: 'w5', d: wire((X) => `M ${X(264)} 670 L ${X(264)} 780`), flow: 'upload', step: 4 },
  { id: 'w6', d: wire((X) => `M ${X(264)} 840 L ${X(264)} 950`), flow: 'upload', step: 4 },
  { id: 'w7', d: wire((X) => `M ${X(244)} 1010 L ${X(180)} 1010 L ${X(180)} 1128`), flow: 'upload', step: 5, label: steps[4]?.label },
  { id: 'w8', d: wire((X) => `M ${X(180)} 1194 L ${X(180)} 1298`), flow: 'response', step: 6, stream: true, label: steps[5]?.label },
];
const dur = (w: Wire) => (w.step ? 900 : 3200);
const begin = (i: number, w: Wire) => (w.step ? `-${(w.step - 1) * 0.45}s` : `-${i * 1.1 + 0.3}s`);
const labelAt = (w: Wire): { x: number; y: number } => {
  const m = /M (\d+(?:\.\d+)?) (\d+(?:\.\d+)?)/.exec(w.d);
  const l = /L (\d+(?:\.\d+)?) (\d+(?:\.\d+)?)(?: L|$)/.exec(w.d);
  const x1 = m ? Number(m[1]) : 0;
  const y1 = m ? Number(m[2]) : 0;
  const x2 = l ? Number(l[1]) : x1;
  const y2 = l ? Number(l[2]) : y1;
  return { x: (x1 + x2) / 2, y: (y1 + y2) / 2 - 8 };
};
---
<svg class={`lp lp-${variant}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${uid}-t ${uid}-d`} preserveAspectRatio="xMidYMin meet">
  <title id={`${uid}-t`}>{title}</title>
  <desc id={`${uid}-d`}>{desc}</desc>
  <defs>
    <marker id={`${uid}-ah`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="lp-head" d="M 0 1 L 9 5 L 0 9 z"></path>
    </marker>
  </defs>
  {wires.map((w, i) => {
    const at = labelAt(w);
    return (
      <g>
        <path id={`${uid}-${w.id}`} class={`lp-edge rf-flow-${w.flow}`} d={w.d} marker-end={`url(#${uid}-ah)`}></path>
        {w.stream ? (
          <path class={`lp-march rf-flow-${w.flow}`} d={w.d}></path>
        ) : (
          <g class={`rf-flow-${w.flow}`}>
            <circle class={`lp-pulse rf-pulse rf-flow-${w.flow}`} r="4.5">
              <animateMotion dur={`${dur(w)}ms`} repeatCount="indefinite" begin={begin(i, w)}>
                <mpath href={`#${uid}-${w.id}`}></mpath>
              </animateMotion>
            </circle>
            <circle class={`lp-pulse rf-pulse rf-flow-${w.flow}`} r="3">
              <animateMotion dur={`${dur(w)}ms`} repeatCount="indefinite" begin={`${begin(i, w).replace('-', '-')}+1.6s`}>
                <mpath href={`#${uid}-${w.id}`}></mpath>
              </animateMotion>
            </circle>
          </g>
        )}
        {w.step && (() => {
          const m = /M (\d+(?:\.\d+)?) (\d+(?:\.\d+)?)/.exec(w.d)!;
          const bx = Number(m[1]);
          const by = Number(m[2]);
          return (
            <g class={`rf-flow-${w.flow}`}>
              <circle class="rf-step-badge" cx={bx} cy={by} r="11"></circle>
              <text class="rf-step-num" x={bx} y={by + 4} text-anchor="middle">{w.step}</text>
            </g>
          );
        })()}
        {w.label && <text class={`lp-label rf-flow-${w.flow}`} x={at.x} y={at.y} text-anchor="middle">{w.label}</text>}
      </g>
    );
  })}
  {nodes.map((n) => {
    const st = iconStyle(n.icon, n.size);
    return (
      <g>
        <rect class="lp-card" x={x(n.cx) - 56} y={n.cy - 56} width="112" height="112" rx="18"></rect>
        <g transform={`translate(${x(n.cx) - n.size / 2}, ${n.cy - n.size / 2})`}>
          <g class={st.class} style={st.style} set:html={ICONS[n.icon]}></g>
        </g>
        {n.name && <text class="lp-name" x={x(n.cx)} y={n.cy + 44} text-anchor="middle">{n.name}</text>}
      </g>
    );
  })}
</svg>
<style>
  .lp { width: 100%; height: auto; font-family: var(--font-sans); }
  html[lang='ar'] .lp { font-family: var(--font-arabic); }
  .lp-card { fill: var(--raised); stroke: var(--edge-strong); stroke-width: 1.4; }
  .lp-edge { fill: none; stroke: currentColor; stroke-width: 2; opacity: 0.9; }
  .lp-march { stroke-width: 2.4; }
  .lp-head { fill: var(--text); }
  .lp-name { fill: var(--text); font-size: 12.5px; font-weight: 600; }
  .lp-narrow .lp-name { font-size: 11px; }
  .lp-narrow .lp-card { width: 92px; height: 92px; x: -46px; }
  .lp-label { font-size: 12px; font-weight: 600; fill: var(--muted); }
</style>
