---
/**
 * The scholar site header: the Al Ummah Now header contract (AlUmmahNow docs/design/NAV.md "Header";
 * markup from the vendored packages/render/src/nav/header.js, styled by www's vendored
 * aun-nav.generated.css; `npm run check:fanous` keeps both byte-identical). Order, mirrored in Arabic:
 * menu (below 1024px) · the site's lockup · env badge · the site's own links · language · light/dark · account (or Sign in). Below 1024px the site's links leave the bar
 * (`aun-collapse`) and the menu button opens them in the `.aun-header-panel` popover (no script
 * needed), so the bar is one 64px (56px) line on every screen. The account button and menu are drawn here and filled from /auth/me by
 * src/scripts/site.ts (the HTML is cached and the same for everyone).
 */
import { fmt } from '../lib/i18n';
import { siteName } from '../lib/seo';
import type { PageContext } from '../lib/context';
import type { SiteNavItem } from '../lib/site-types';
import { libraryUrl } from '../../../../packages/render/src/embeds';
import { envBadgeHtml, langButtonHtml, menuButtonHtml, signInHtml } from '../../../../packages/render/src/nav/header.js';
import { modeIconSvg, modeToggleLabel } from '../../../../packages/render/src/nav/mode-toggle.js';
import { siteBrandHtml } from '../../../../packages/render/src/site-brand';

interface Props { ctx: PageContext; alternates: Partial<Record<'en' | 'ar', string>>; active?: string }
const { ctx, alternates, active } = Astro.props;
const { site, locale, t, cfg } = ctx;
const name = siteName(site, locale);
const logo = site.site.logoUrl || site.channel.avatarUrl;
const PATHS: Record<Exclude<SiteNavItem['kind'], 'url' | 'page'>, string> = { home: '', videos: 'videos/', shorts: 'videos/?kind=shorts', posts: 'posts/', about: 'about/' };
const pages = site.site.pages ?? [];
interface Item { id: string; kind: SiteNavItem['kind']; label: string; href: string; external: boolean }
const items: Item[] = site.site.navigation.flatMap((item): Item[] => {
  if (item.kind === 'page') {
    // A site page (SS16): its title unless the menu item has its own label; gone pages are left out
    const page = pages.find((p) => p.id === item.pageId);
    if (!page) return [];
    return [{ id: item.id, kind: item.kind, label: item.label?.[locale] || page.title[locale] || page.title.en || page.title.ar || page.slug, href: `/${locale}/${page.slug}/`, external: false }];
  }
  const label = item.label?.[locale] || t.nav[item.kind];
  if (item.kind === 'url') return item.url && /^https:\/\//.test(item.url) ? [{ id: item.id, kind: item.kind, label, href: item.url, external: true }] : [];
  // Shorts get their own page in phase 3; until then the menu item opens the videos list
  const href = `/${locale}/${item.kind === 'shorts' ? PATHS.videos : PATHS[item.kind]}`;
  return [{ id: item.id, kind: item.kind, label, href, external: false }];
});
const other = locale === 'ar' ? 'en' : 'ar';
const switchHref = site.site.locales.includes(other) ? alternates[other] ?? `/${other}/` : null;
const returnTo = Astro.url.pathname + Astro.url.search;
const wwwHref = `${cfg.wwwUrl}/${locale}/`;
const videosHref = libraryUrl(cfg.videosWebUrl, locale);
const toDark = modeToggleLabel(locale, false);
const toLight = modeToggleLabel(locale, true);
const icon = (id: string) => `<img class="aun-app-icon" data-app="${id}" src="/aun-nav/icons/${id}.webp" width="32" height="32" alt="" loading="lazy" decoding="async">`;
---
<header class="site-header aun-header">
  <div class="aun-header-row">
    {items.length > 0 && <Fragment set:html={menuButtonHtml({ lang: locale, panel: 'site-menu' })} />}
    <Fragment set:html={siteBrandHtml({ lang: locale, href: `/${locale}/`, name, logoSrc: logo })} />
    <Fragment set:html={envBadgeHtml(cfg.appEnv, locale)} />
    <div class="aun-header-primary aun-collapse">
      <nav aria-label={t.mainNav} class="site-nav">
        <ul>
          {items.map((i) => (
            <li>
              <a href={i.href} aria-current={active === i.kind ? 'page' : undefined} rel={i.external ? 'noopener' : undefined} data-testid={`site-nav-${i.id}`}>{i.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="aun-header-tools">
      {switchHref && <Fragment set:html={langButtonHtml({ lang: locale, href: switchHref })} />}
      {/* Light / Dark: nav/header.js modeButtonHtml's button with both icons (CSS shows the mode on screen) */}
      <button type="button" class="aun-icon-btn aun-mode" id="mode-toggle" data-testid="theme-toggle" data-mode-toggle data-label-light={toLight} data-label-dark={toDark} aria-label={toDark} title={toDark}>
        <Fragment set:html={modeIconSvg('moon', 'mode-moon')} />
        <Fragment set:html={modeIconSvg('sun', 'mode-sun')} />
      </button>
      <Fragment set:html={signInHtml({ lang: locale, href: `/auth/login?return=${encodeURIComponent(returnTo)}&lang=${locale}` })} />
      <div class="account" id="account" data-testid="site-account">
        <button type="button" class="aun-acct-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="account-menu" data-testid="site-account-button">
          <span class="aun-avatar" aria-hidden="true" data-account-initial></span>
          <span class="aun-visually-hidden">{t.account}: </span>
          <span class="aun-acct-name" dir="auto" data-account-name></span>
          <svg class="aun-caret" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 6 8 10.5 12.5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <ul class="aun-menu" id="account-menu" hidden>
          <li class="aun-menu-who">
            <span class="aun-avatar aun-avatar--lg" aria-hidden="true" data-account-initial></span>
            <span class="aun-menu-who-text">
              <span class="aun-menu-who-name" dir="auto" data-account-name></span>
              <span class="aun-visually-hidden" data-account-signed-in-as data-template={t.signedInAs}>{fmt(t.signedInAs, { name: '' })}</span>
              <span class="aun-menu-who-sub aun-email" dir="ltr" data-account-email hidden><span class="aun-email-local"></span><span class="aun-email-domain"></span></span>
            </span>
          </li>
          <li class="aun-menu-sep" aria-hidden="true"></li>
          <li>
            <span class="aun-menu-label" id="account-apps-label">{t.apps}</span>
            <ul aria-labelledby="account-apps-label">
              <li><a class="aun-menu-item" href={wwwHref}><Fragment set:html={icon('www')} /><span class="aun-menu-text">{t.www}</span></a></li>
              <li><a class="aun-menu-item" href={videosHref}><Fragment set:html={icon('videos')} /><span class="aun-menu-text">{t.videos}</span></a></li>
              <li><a class="aun-menu-item" href={cfg.profileUrl}><Fragment set:html={icon('profile')} /><span class="aun-menu-text">{t.profile}</span></a></li>
            </ul>
          </li>
          <li class="aun-menu-sep" aria-hidden="true"></li>
          <li>
            <form method="post" action="/auth/logout">
              <input type="hidden" name="return" value={`/${locale}/`} />
              <button type="submit" class="aun-menu-item" data-testid="site-sign-out">
                <svg class="aun-menu-icon aun-flip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H5v16h4M14 8l4 4-4 4M18 12H8" /></svg>
                <span class="aun-menu-text">{t.signOut}</span>
              </button>
            </form>
          </li>
        </ul>
      </div>
    </div>
  </div>
  {items.length > 0 && (
    <div id="site-menu" class="aun-header-panel" popover>
      <nav aria-label={t.mainNav} class="panel-nav">
        <ul>
          {items.map((i) => (
            <li>
              <a href={i.href} aria-current={active === i.kind ? 'page' : undefined} rel={i.external ? 'noopener' : undefined}>{i.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}
</header>
