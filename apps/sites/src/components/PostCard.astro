---
import type { SitePost } from '../lib/data';
import type { PageContext } from '../lib/context';
import { formatDate, plural } from '../../../../packages/render/src/format';
import { isArticleKind } from '../../../../packages/render/src/posts/post-kinds';
import { safeHttpsUrl } from '../../../../packages/render/src/urls';
import PostKindBody from '../../../../packages/render/src/posts/PostKindBody.astro';
import PostKindSummary from '../../../../packages/render/src/posts/PostKindSummary.astro';
import PostEngagement from '../../../../packages/render/src/posts/PostEngagement.astro';
import { sitePostRenderProps } from '../lib/post-render';

interface Props { ctx: PageContext; post: SitePost; full?: boolean }
const { ctx, post, full = false } = Astro.props;
const { locale, t } = ctx;
const date = post.createdAt ? new Date(post.createdAt) : null;
const { body, summary, ref, href, videoHref, paragraphs, preview, hasMore } = sitePostRenderProps(post, ctx);
const articleKind = isArticleKind(post.kind);
const origin = ctx.data.apiUrl;
---
<article class="post-card" data-testid="site-post" data-kind={post.kind}>
  {date && <p class="post-date"><a href={href}><time datetime={post.createdAt}>{formatDate(date, locale, { year: 'numeric', month: 'long', day: 'numeric' })}</time></a></p>}
  {post.article && (
    <div class="post-article">
      {post.article.coverUrl && <img src={post.article.coverUrl} alt="" loading="lazy" width="640" height="360" />}
      <h2 class="post-title" dir="auto">{post.article.title}</h2>
      {post.article.excerpt && <p dir="auto">{post.article.excerpt}</p>}
      {safeHttpsUrl(post.article.url) && <p><a href={safeHttpsUrl(post.article.url)!}>{t.readArticle}</a></p>}
    </div>
  )}
  {post.designedCard && (post.slides[0]?.alt || post.text) && <p dir="auto" style="white-space:pre-wrap">{post.slides[0]?.alt || post.text}</p>}
  {post.designedCard?.quran && <p><a href="https://quran.foundation/">{locale === 'ar' ? 'مؤسسة القرآن' : 'Quran Foundation'}</a></p>}
  {articleKind && !post.designedCard && (full ? paragraphs : preview).map((p) => <p dir="auto">{p}</p>)}
  {articleKind && post.images.length > 0 && (
    <ul class:list={['post-kind-images', post.images.length > 1 && 'post-kind-images-many']}>
      {(full ? post.images : summary.v2.images).map((img) => <li><img src={img.url} alt={img.alt} loading="lazy" width={img.width ?? undefined} height={img.height ?? undefined} /></li>)}
    </ul>
  )}
  {post.slides.length > 0 && (
    <ol class="post-slides" data-testid="site-post-slides">
      {post.slides.slice(0, full ? 40 : 3).map((sl) => (
        <li class="post-slide">
          <img src={sl.url} alt={sl.alt} loading="lazy" />
          {(sl.heading || sl.body) && (
            <div class="post-slide-text" dir="auto">
              {sl.heading && <p class="post-slide-heading">{sl.heading}</p>}
              {sl.body && <p>{sl.body}</p>}
            </div>
          )}
        </li>
      ))}
    </ol>
  )}
  {!full && post.slides.length > 3 && <p><a href={href}>{plural(post.slides.length - 3, t.moreCards, locale)}</a></p>}
  {!articleKind && (full
    ? <PostKindBody post={body} locale={locale} cmsOrigin={origin} videosWebUrl={ctx.cfg.videosWebUrl} localVideoHref={videoHref} />
    : <PostKindSummary post={summary} locale={locale} cmsOrigin={origin} preview={{ paragraphs: preview, videoHref }} />)}
  {!full && !post.designedCard && hasMore && <p class="post-kind-action"><a href={href}>{t.more}</a></p>}
  <PostEngagement postRef={ref} locale={locale} likes={post.likes} comments={post.comments} discussion={full} />
</article>
