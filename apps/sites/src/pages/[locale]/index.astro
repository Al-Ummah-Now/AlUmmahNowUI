---
import SiteLayout from '../../layouts/SiteLayout.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import PostCard from '../../components/PostCard.astro';
import { pageContext } from '../../lib/context';
import { channelPosts, channelVideos } from '../../lib/data';
import { alternates, canonicalUrl, siteName } from '../../lib/seo';

const ctx = pageContext(Astro);
if (!ctx) return new Response('Not found', { status: 404 });
const { site, locale, t } = ctx;
const [videos, posts] = await Promise.all([channelVideos(ctx.data, site.channel.id, { limit: 8 }), channelPosts(ctx.data, site.channel.id, 1, 5)]);
const name = siteName(site, locale);
const intro = site.channel.descriptionLocalized?.[locale] || site.channel.description;
const logo = site.site.logoUrl || site.channel.avatarUrl;
---
<SiteLayout ctx={ctx} title={name} alternates={alternates(site, '')} canonical={canonicalUrl(site, locale, '', ctx.scheme)} active="home">
  <section class="hero wrap" data-testid="site-hero">
    {logo && <img src={logo} alt="" width="96" height="96" class="hero-logo" />}
    <div>
      <h1 data-testid="site-name">{name}</h1>
      {intro && <p class="hero-intro">{intro.split('\n')[0]}</p>}
    </div>
  </section>
  <section class="wrap section" aria-labelledby="latest-videos">
    <div class="section-head">
      <h2 id="latest-videos">{t.latestVideos}</h2>
      <a href={`/${locale}/videos/`}>{t.allVideos}</a>
    </div>
    {videos.items.length ? <VideoGrid videos={videos.items} locale={locale} testId="site-home-videos" /> : <p class="empty">{t.noVideos}</p>}
  </section>
  <section class="wrap section narrow" aria-labelledby="latest-posts">
    <div class="section-head">
      <h2 id="latest-posts">{t.latestPosts}</h2>
      <a href={`/${locale}/posts/`}>{t.allPosts}</a>
    </div>
    {posts.items.length ? posts.items.map((p) => <PostCard ctx={ctx} post={p} />) : <p class="empty">{t.noPosts}</p>}
  </section>
</SiteLayout>
