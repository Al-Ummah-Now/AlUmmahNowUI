---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { strings } from '../i18n';
import type { NavItem, SiteSettings } from '../lib/cms-types';
import type { Config } from '../lib/env';
import { dir, otherLocale, type Locale } from '../lib/locale';
import { headLinks, jsonLdText, ogImageUrl, type Alternates } from '../lib/seo';
import { MODE_SCRIPT } from '../lib/theme-mode';
import { THEME_CHROME, themeFromRequest } from '../lib/site-theme';
import { tabIconLinks } from '../lib/favicon';

interface Props {
  cfg: Config;
  locale: Locale;
  title: string;
  description?: string | null;
  /** Path of this page in each locale that exists (for canonical, hreflang and the switcher). */
  alternates: Alternates;
  nav: { header: NavItem[]; footer: NavItem[] };
  settings?: SiteSettings | null;
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  jsonLd?: unknown[];
  noindex?: boolean;
  /** A 404 or 500 page: no canonical, hreflang or og:url (lib/seo headLinks) */
  errorPage?: boolean;
  /** Notice shown above the content (e.g. "not yet available in Arabic"). */
  notice?: string | null;
  /** A link after the notice (e.g. "Read it in العربية" on an article that is only in Arabic). */
  noticeLink?: { href: string; label: string; lang: Locale } | null;
  /** Language of the main content when it differs from the UI (missing translation). */
  contentLocale?: Locale;
  /** An extra feed for this page (a scholar's articles), listed after the site's. */
  feed?: { title: string; href: string } | null;
  /**
   * The canonical and hreflang set when they live on another host (a scholar's own site, lib/scholar-site).
   * `alternates` still drives the language switch.
   */
  seoLinks?: { canonical: string; hreflang: { hreflang: string; href: string }[] } | null;
}

const { cfg, locale, title, description, alternates, nav, settings, ogImage, ogType = 'website', jsonLd = [], noindex, errorPage, notice, noticeLink, contentLocale, feed, seoLinks } = Astro.props;
const t = strings(locale);
const siteName = settings?.site_title || t.meta.siteName;
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const desc = (description || settings?.tagline || t.meta.defaultDescription).slice(0, 300);
const { canonical, hreflang } = seoLinks && !errorPage ? seoLinks : headLinks(cfg, alternates, { locale, contentLocale, pathname: Astro.url.pathname, errorPage });
const other = otherLocale(locale);
const switchHref = alternates[other] ?? `/${other}/`;
const image = ogImageUrl(cfg, ogImage);
// The admin's site theme, resolved by the Worker (src/worker.ts); rendered here so the first paint is right
const theme = themeFromRequest(Astro.request).id;
const chrome = THEME_CHROME[theme];
const robots = noindex || !cfg.isProduction ? 'noindex, nofollow' : 'index, follow';
---
<!doctype html>
<html lang={locale} dir={dir(locale)} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflang.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    <link rel="alternate" type="application/rss+xml" title={`${siteName}: ${t.articles.title}`} href={`/${locale}/rss.xml`} />
    {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_AR' : 'en_GB'} />
    {alternates[other] && <meta property="og:locale:alternate" content={other === 'ar' ? 'ar_AR' : 'en_GB'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={image} />
    <meta name="color-scheme" content="light dark" />
    {/* In <head>, before the body paints: the saved Light/Dark choice is on <html> before first paint (CSP: by hash) */}
    <script is:inline set:html={MODE_SCRIPT} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={chrome.light} data-light={chrome.light} data-dark={chrome.dark} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={chrome.dark} data-light={chrome.light} data-dark={chrome.dark} />
    {tabIconLinks(cfg.appEnv).map((l) => <link rel="icon" href={l.href} type={l.type} sizes={l.sizes} />)}
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    {locale === 'ar' && <link rel="preload" href="/fonts/noto-naskh-arabic-arabic-400-normal.woff2" as="font" type="font/woff2" crossorigin />}
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={jsonLdText(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <slot name="banner" />
    <Header cfg={cfg} locale={locale} nav={nav.header} switchHref={switchHref} />
    {notice && (
      <div class="notice" role="note">
        <p class="wrap">{notice}{noticeLink && <> <a href={noticeLink.href} hreflang={noticeLink.lang}>{noticeLink.label}</a></>}</p>
      </div>
    )}
    <main id="main" tabindex="-1" lang={contentLocale && contentLocale !== locale ? contentLocale : undefined} dir={contentLocale && contentLocale !== locale ? dir(contentLocale) : undefined}>
      <slot />
    </main>
    <Footer locale={locale} nav={nav.footer} settings={settings ?? null} videosWebUrl={cfg.videosWebUrl} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
