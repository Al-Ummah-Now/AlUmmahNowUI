---
/**
 * /{l}/newsletter/confirm?token=: the link in the confirmation email (admin-api lib/newsletter.ts).
 * GET only shows a button (mail scanners open links); its POST confirms. Never cached.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadChrome, markSource, requestContext, routeLocale } from '../../../lib/context';
import { confirmSubscription, newsletterDeps, TOKEN, type ConfirmOutcome } from '../../../lib/newsletter';

const locale = routeLocale(Astro);
if (!locale) return new Response(null, { status: 404 });
const rc = requestContext(Astro, locale);
const { cfg, env, t } = rc;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

let token = Astro.url.searchParams.get('token') ?? '';
let outcome: ConfirmOutcome | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  token = typeof form?.get('token') === 'string' ? String(form!.get('token')) : token;
  outcome = await confirmSubscription(newsletterDeps(env, cfg), token);
} else if (Astro.request.method !== 'GET' && Astro.request.method !== 'HEAD') {
  return new Response(null, { status: 405, headers: { Allow: 'GET, POST' } });
}
if (!outcome && !TOKEN.test(token)) outcome = 'invalid';
if (outcome === 'unavailable') Astro.response.status = 503;
const chrome = await loadChrome(rc);
markSource(Astro, rc);
const n = t.newsletter;
const view =
  outcome === 'confirmed' ? { title: n.confirmedTitle, body: n.confirmedBody }
  : outcome === 'expired' ? { title: n.expiredTitle, body: n.expiredBody }
  : outcome === 'invalid' ? { title: n.invalidTitle, body: n.invalidBody }
  : outcome === 'unavailable' ? { title: n.unavailableTitle, body: n.unavailableBody }
  : { title: n.confirmTitle, body: n.confirmIntro };
---
<BaseLayout cfg={cfg} locale={locale} title={view.title} alternates={{ en: '/en/newsletter/', ar: '/ar/newsletter/' }} nav={chrome.nav} settings={chrome.settings} noindex>
  <div class="page-head" data-newsletter-result={outcome ?? 'ask'}>
    <div class="wrap">
      <h1>{view.title}</h1>
      <p class="lede">{view.body}</p>
    </div>
  </div>
  <section class="section nl-result">
    <div class="wrap nl-actions">
      {(!outcome || outcome === 'unavailable') && (
        <form method="post" action={`/${locale}/newsletter/confirm`}>
          <input type="hidden" name="token" value={token} />
          <button class="button button-primary" type="submit">{n.confirmButton}</button>
        </form>
      )}
      {(outcome === 'expired' || outcome === 'invalid') && <a class="button button-primary" href={`/${locale}/newsletter/`}>{n.signUp}</a>}
      <a class="nl-home" href={`/${locale}/`}>{n.home}</a>
    </div>
  </section>
</BaseLayout>
