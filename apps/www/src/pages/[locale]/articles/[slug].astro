---
import ErrorView from '../../../components/ErrorView.astro';
import PostArticle from '../../../components/PostArticle.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { documentAlternates, renderBody } from '../../../lib/body';
import { fmt } from '../../../i18n';
import { cardPostSeo, slideFromLink } from '../../../lib/cards';
import { loadChrome, markSource, requestContext, routeLocale } from '../../../lib/context';
import { otherLocale } from '../../../lib/locale';
import { plainText } from '../../../lib/markdown';
import { articleLd, videoObjectLd } from '../../../lib/seo';

const locale = routeLocale(Astro);
const slug = Astro.params.slug ?? '';
if (!locale || !/^[\p{L}\p{N}_-]{1,120}$/u.test(slug)) return new Response(null, { status: 404 });
const rc = requestContext(Astro, locale);
const { cfg, t } = rc;
const [chrome, first] = await Promise.all([loadChrome(rc), rc.cms.post(locale, slug)]);
let result = first;
// No version in this locale (docs/SPEC.md §4 "Articles in one language"): look for the slug in the
// other locale. If that post has a translation here under another slug (its `alternates`), go
// there (301); otherwise show it, in its own language, with "Only available in العربية" and a link
// to its own URL (the canonical; the borrowed copy is noindex).
if (result.status === 'not_found') {
  const other = await rc.cms.post(otherLocale(locale), slug);
  if (other.status === 'ok') {
    const here = other.data.alternates.find((a) => a.locale === locale);
    if (here && here.slug !== slug) return Astro.redirect(`/${locale}/articles/${encodeURIComponent(here.slug)}/${Astro.url.search}`, 301);
    result = other;
  }
}
// A renamed article's old address: 301 to its current one (CMS slug history, D-SEO-7)
if (result.status === 'not_found') {
  const renamed = await rc.cms.redirect('post', locale, slug);
  if (renamed) return Astro.redirect(`/${locale}/articles/${encodeURIComponent(renamed)}/${Astro.url.search}`, 301);
}
markSource(Astro, rc);
if (result.status === 'not_found') return new Response(null, { status: 404 });
if (result.status === 'unavailable') Astro.response.status = 503;

const post = result.status === 'ok' ? result.data : null;
const body = post ? await renderBody(rc, post.body, post.locale, post.images) : null;
const alternates = post ? documentAlternates(post, post.alternates, (l, s) => `/${l}/articles/${encodeURIComponent(s)}/`) : {};
const translated = post && post.locale !== locale;
const cardSeo = post ? cardPostSeo(post) : null;
// Never the site's default text: a post with no text of its own is described by its title
const description = post ? post.seo_description || post.excerpt || cardSeo?.text || plainText(post.body, 180) || post.title : '';
// `?slide=3` opens a card post on its third card (the server renders it; `#3` is read by the script).
const slide = post?.slides?.length ? slideFromLink(Astro.url.search, '', post.slides.length) : 0;
const jsonLd = post
  ? [
      articleLd(cfg, {
        title: post.title,
        description,
        url: alternates[post.locale] ?? Astro.url.pathname,
        image: cardSeo?.image ?? null,
        published: post.published_at,
        modified: post.updated_at,
        author: post.author_name,
        authorUrl: post.author ? `/${post.locale}/scholars/${encodeURIComponent(post.author.slug)}/` : null,
        locale: post.locale,
      }),
      ...(body?.videos ?? []).map((v) => videoObjectLd(cfg, v, post.locale)).filter(Boolean),
    ]
  : [];
---
<BaseLayout
  cfg={cfg}
  locale={locale}
  title={post ? post.seo_title || post.title : t.errors.unavailableTitle}
  description={description}
  alternates={post ? alternates : { [locale]: Astro.url.pathname }}
  nav={chrome.nav}
  settings={chrome.settings}
  ogType={post ? 'article' : 'website'}
  ogImage={cardSeo?.image ?? undefined}
  jsonLd={jsonLd}
  noindex={!post || !!translated}
  notice={post && translated ? fmt(t.lang.onlyIn, { language: t.lang.names[post.locale] }) : null}
  noticeLink={post && translated ? { href: alternates[post.locale]!, label: fmt(t.lang.readIn, { language: t.lang.names[post.locale] }), lang: post.locale } : null}
  contentLocale={post?.locale}
>
  {post && body ? (
    <PostArticle post={post} html={body.html} locale={locale} slide={slide} pathname={Astro.url.pathname} cmsOrigin={new URL(cfg.cmsPublicUrl).origin} />
  ) : (
    <ErrorView locale={locale} kind="unavailable" />
  )}
</BaseLayout>
