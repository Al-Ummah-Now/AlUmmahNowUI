---
/**
 * /videos: the CMS list page `videos` (a filter page over the CMS video library, docs/specs/
 * WWW-PAGES.md D2), or www's built-in filter page when the CMS has none or cannot be reached.
 */
import ListPage from '../../components/ListPage.astro';
import { libraryUrl } from '../../lib/embeds';
import { loadChrome, markSource, requestContext, routeLocale } from '../../lib/context';
import { loadList, pageQuery, parsePage } from '../../lib/list-page';

const locale = routeLocale(Astro);
if (!locale) return new Response(null, { status: 404 });
const page = parsePage(Astro.url.searchParams.get('page'));
if (page === null) return new Response(null, { status: 404 });
const rc = requestContext(Astro, locale);
const { cfg, t } = rc;
const [chrome, list] = await Promise.all([loadChrome(rc), loadList({ cms: rc.cms, locale, slug: 'videos', page, builtin: 'videos' })]);
if (list.status !== 'ok') return new Response(null, { status: 404 });
markSource(Astro, rc);
const library = libraryUrl(cfg.videosWebUrl, locale);
---
<ListPage
  cfg={cfg}
  locale={locale}
  nav={chrome.nav}
  settings={chrome.settings}
  view={list.view}
  path={`/${locale}/videos/`}
  alternates={{ en: `/en/videos/${pageQuery(page)}`, ar: `/ar/videos/${pageQuery(page)}` }}
>
  <p slot="actions"><a class="button button-quiet" href={library}>{t.videos.browseAll}</a></p>
  <div slot="empty" class="empty">
    <p>{t.videos.empty}</p>
    <p>{t.videos.emptyHint}</p>
    <a class="button button-quiet" href={library}>{t.videos.browseAll}</a>
  </div>
</ListPage>
