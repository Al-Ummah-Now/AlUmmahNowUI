---
/**
 * The Al Ummah Now header (AlUmmahNow docs/design/NAV.md "Header"; wiki E10): the shared frame and
 * controls of every app. Markup from the vendored builders (packages/render/src/nav/header.js, kept
 * byte-identical by `npm run check:fanous`), styled by aun-nav.generated.css; www adds only its own
 * links and search in the primary slot (src/styles/header.css). Order, mirrored in Arabic:
 * menu (below 1024px) · brand · env badge · links + search · language · light/dark ·
 * account (or Sign in; neither, nor the silent sign-in probe, when sign-in isn't configured: cfg.signIn).
 * The search is the shared one (NAV.md "Search"): in the bar from 1024px; below it the
 * `.aun-search-open` icon opens it as a sheet over the bar (a popover, no script needed). Below 1024px the
 * links leave the bar and the menu button opens them in the `.aun-header-panel` popover, so the bar is
 * one 64px (56px) line on every screen.
 * apps/dev renders the same header (its tests compare its markup with this file).
 */
import Icon from './Icon.astro';
import SearchBox from './SearchBox.astro';
import { strings } from '../i18n';
import { navHref } from '../lib/context';
import type { NavItem } from '../lib/cms-types';
import { libraryUrl } from '../lib/embeds';
import type { Config } from '../lib/env';
import type { Locale } from '../lib/locale';
import { BACK_ICON_BODY, HEADER_LABELS, SEARCH_ICON_BODY, brandHtml, envBadgeHtml, langButtonHtml, menuButtonHtml, signInHtml } from '../../../../packages/render/src/nav/header.js';
import { MODE_ICON_ATTRS, modeIconSvg, modeToggleLabel } from '../../../../packages/render/src/nav/mode-toggle.js';

interface Props { cfg: Config; locale: Locale; nav: NavItem[]; switchHref: string }
const { cfg, locale, nav, switchHref } = Astro.props;
const t = strings(locale);
const path = Astro.url.pathname;
const current = (href: string) => (href === path || (href !== `/${locale}/` && path.startsWith(href)) ? 'page' : undefined);
const items = nav.flatMap((n) => {
  const href = navHref(n.url, locale);
  return href ? [{ label: n.label, href }] : [];
}).slice(0, 6);
const toDark = modeToggleLabel(locale, false);
const toLight = modeToggleLabel(locale, true);
const loginHref = `/auth/login?return=${encodeURIComponent(path + Astro.url.search)}`;
const videosUrl = libraryUrl(cfg.videosWebUrl, locale);
// the shared search's icon button and back arrow (nav/header.js searchHtml's markup; NAV.md "Search")
const searchLabels = HEADER_LABELS[locale];
const navIcon = (name: string, body: string) => `<svg ${MODE_ICON_ATTRS} class="lucide lucide-${name}" aria-hidden="true" focusable="false">${body}</svg>`;
---
<header class="site-header aun-header">
  <div class="aun-header-row">
    <Fragment set:html={menuButtonHtml({ lang: locale, panel: 'site-menu' })} />
    <Fragment set:html={brandHtml({ lang: locale, href: `/${locale}/`, logoSrc: '/brand/logo-192.webp' })} />
    <Fragment set:html={envBadgeHtml(cfg.appEnv, locale)} />
    <div class="aun-header-primary">
      <nav class="primary-nav" aria-label={t.a11y.primaryNav}>
        <ul>
          {items.map((i) => (
            <li><a href={i.href} aria-current={current(i.href)}>{i.label}</a></li>
          ))}
        </ul>
      </nav>
      <button type="button" class="aun-icon-btn aun-search-open" popovertarget="site-search-sheet" data-testid="header-search-open" aria-label={searchLabels.search} title={searchLabels.search}>
        <Fragment set:html={navIcon('search', SEARCH_ICON_BODY)} />
      </button>
      <div class="aun-search-slot" id="site-search-sheet" popover="auto" data-testid="header-search-sheet">
        <button type="button" class="aun-search-back" popovertarget="site-search-sheet" popovertargetaction="hide" data-testid="header-search-back" aria-label={searchLabels.back} title={searchLabels.back}>
          <Fragment set:html={navIcon('arrow-left', BACK_ICON_BODY)} />
        </button>
        <SearchBox cfg={cfg} locale={locale} id="site-search" />
      </div>
    </div>
    <div class="aun-header-tools">
      <Fragment set:html={langButtonHtml({ lang: locale, href: switchHref })} />
      <!-- Light / Dark (src/scripts/theme.ts): nav/header.js modeButtonHtml's button with both icons, so the
           cached page can show the device's mode before any choice (CSS picks the icon from data-current) -->
      <button type="button" class="aun-icon-btn aun-mode" id="mode-toggle" data-testid="theme-toggle" aria-label={toDark} title={toDark} data-label-dark={toDark} data-label-light={toLight} data-current="light">
        <Fragment set:html={modeIconSvg('moon', 'mode-moon')} />
        <Fragment set:html={modeIconSvg('sun', 'mode-sun')} />
      </button>
      {/* Sign-in not configured (no valid SESSION_SECRET): no Sign in, no account menu, no /auth/me probe (scripts/site.ts needs #account) */}
      {cfg.signIn && (
        <div
          class="account"
          id="account"
          data-me="/auth/me"
          data-auth-url={cfg.authUrl}
          data-label-accounts={t.auth.accounts}
          data-label-current={t.auth.current}
          data-label-switch-to={t.auth.switchTo}
          data-label-add-account={t.auth.addAccount}
          data-label-sign-out-of={t.auth.signOutOf}
          data-label-sign-out-all={t.auth.signOutAll}
          data-label-menu={t.a11y.accountMenu}
          data-label-signed-in-as={t.auth.signedInAs}
          data-label-profile={t.auth.profile}
          data-label-videos={t.auth.videos}
          data-label-cms={t.auth.cms}
          data-label-apps={t.auth.apps}
          data-label-more-accounts={t.auth.moreAccounts}
          data-label-sign-out={t.auth.signOut}
          data-label-confirm-sign-out-of-title={t.auth.confirmSignOutOfTitle}
          data-label-confirm-sign-out-of-body={t.auth.confirmSignOutOfBody}
          data-label-confirm-sign-out-all-title={t.auth.confirmSignOutAllTitle}
          data-label-confirm-sign-out-all-body={t.auth.confirmSignOutAllBody}
          data-profile-url={cfg.profileUrl}
          data-videos-url={videosUrl}
          data-cms-url={`${cfg.cmsPublicUrl}/`}
          data-locale={locale}
        >
          <Fragment set:html={signInHtml({ lang: locale, href: loginHref })} />
        </div>
      )}
    </div>
  </div>
  <!-- below 1024px: the same links, opened by the menu button (first in the bar); the search has its own icon.
       Where the bar has no room for that icon (header.css: under 360px, Arabic, signed out) the panel links to
       the search page instead -->
  <div id="site-menu" class="aun-header-panel" popover>
    <nav class="panel-nav" aria-label={t.a11y.primaryNav}>
      <ul>
        {items.map((i) => (
          <li><a href={i.href} aria-current={current(i.href)}>{i.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="panel-search" href={`/${locale}/search`} data-testid="panel-search-link">
      <Fragment set:html={navIcon('search', SEARCH_ICON_BODY)} />
      <span>{searchLabels.search}</span>
    </a>
  </div>
  <template id="caret-icon"><Icon name="caret" /></template>
  <template id="signout-icon"><svg class="aun-flip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H5v16h4M14 8l4 4-4 4M18 12H8" /></svg></template>
  <template id="signin-icon"><svg class="aun-menu-icon aun-flip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4h4v16h-4M10 8l4 4-4 4M14 12H3" /></svg></template>
  <template id="check-icon"><svg class="aun-menu-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" /></svg></template>
  <!-- the one in-app confirmation for destructive actions (./scripts/confirm.ts); never window.confirm -->
  <dialog class="confirm-dialog" id="confirm-dialog" aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-body">
    <div class="confirm-dialog-inner">
      <h2 class="confirm-dialog-title" id="confirm-dialog-title"></h2>
      <p class="confirm-dialog-body" id="confirm-dialog-body"></p>
      <div class="confirm-dialog-actions">
        <button type="button" class="confirm-dialog-cancel" data-confirm-cancel>{t.auth.cancel}</button>
        <button type="button" class="confirm-dialog-ok" data-confirm-ok></button>
      </div>
    </div>
  </dialog>
</header>
