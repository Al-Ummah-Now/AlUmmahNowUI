---
/**
 * A CMS page built from blocks: the shared page-builder renderer's HTML (src/lib/blocks.ts), with
 * www's own components where it left a slot (the paged card grid, video shelves, post lists). The
 * blocks lay themselves out (packages/render/src/page-blocks/page-blocks.generated.css: widths, tones,
 * spacing, RTL); every image carries its width and height, so nothing moves while the page fills in.
 * No inline styles: the site's CSP is style-src 'self' (src/lib/edge.ts).
 */
import CardGrid from './CardGrid.astro';
import ArticlesList from './ArticlesList.astro';
import VideoRail from './VideoRail.astro';
import { splitSlots, type PreparedPage } from '../lib/blocks';
import type { Config } from '../lib/env';
import type { Locale } from '../lib/locale';

interface Props { built: PreparedPage; locale: Locale; contentLocale: Locale; cfg: Config }
const { built, locale, contentLocale, cfg } = Astro.props;
// [html, slot id, html, slot id, …, html]: the renderer's HTML around each slot marker.
const parts = splitSlots(built.html);
---
{parts.map((part, i) => {
  if (i % 2 === 0) return <Fragment set:html={part} />;
  const s = built.slots[part];
  if (!s) return null;
  const heading = s.heading ? <h2 class="pb-heading" id={`pb-${s.id}-h`}>{s.heading}</h2> : null;
  switch (s.type) {
    case 'cards':
      return <CardGrid grid={s.grid} locale={locale} contentLocale={contentLocale} heading={s.heading} id={s.id} />;
    case 'videos':
      return <>{heading}<VideoRail cfg={cfg} locale={locale} items={s.items} /></>;
    case 'posts':
      return <>{heading}<ArticlesList locale={locale} posts={s.items} headingLevel={s.heading ? 3 : 2} cmsOrigin={new URL(cfg.cmsPublicUrl).origin} /></>;
  }
})}
