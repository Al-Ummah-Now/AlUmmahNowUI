---
/** Small inline icons. `dir` icons flip in RTL (.dir-icon). */
interface Props { name: 'chevron' | 'arrow' | 'star' | 'caret' | 'expand' | 'close' | 'cards' | 'play' | 'pause' | 'sound-off' | 'sound-on' | 'up' | 'down'; class?: string }
const { name, class: className } = Astro.props;
---
{name === 'arrow' && (
  <svg class:list={['dir-icon', className]} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
{name === 'chevron' && (
  <svg class:list={['dir-icon', className]} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
{name === 'caret' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 6 8 10.5 12.5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
{name === 'star' && (
  <svg class={className} viewBox="0 0 36 36" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.5"><rect x="9" y="9" width="18" height="18" /><rect x="9" y="9" width="18" height="18" transform="rotate(45 18 18)" /><circle cx="18" cy="18" r="3.5" /></g></svg>
)}
{name === 'expand' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M9.5 2.5h4v4M6.5 13.5h-4v-4M13.5 2.5 9 7M2.5 13.5 7 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
{name === 'close' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m3.5 3.5 9 9m0-9-9 9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
)}
{name === 'cards' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><rect x="2" y="4.5" width="9" height="9.5" rx="1.5" /><path d="M5 2h7.5A1.5 1.5 0 0 1 14 3.5V11" stroke-linecap="round" /></g></svg>
)}
{name === 'play' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor" /></svg>
)}
{name === 'pause' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 3h2.5v10H4.5zm4.5 0h2.5v10H9z" fill="currentColor" /></svg>
)}
{name === 'sound-off' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 6h2.5L8.5 3v10L5 10H2.5z" fill="currentColor" /><path d="m11 6 3.5 4m0-4L11 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
)}
{name === 'sound-on' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 6h2.5L8.5 3v10L5 10H2.5z" fill="currentColor" /><path d="M10.8 5.6a3.4 3.4 0 0 1 0 4.8M12.6 3.8a6 6 0 0 1 0 8.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
)}
{name === 'up' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 10 8 5.5 12.5 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
{name === 'down' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 6 8 10.5 12.5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
