---
/**
 * A list of posts (the Articles page, a page's posts block). Card posts show every card inline
 * (CardViewer `inline`), so they read whole here; the title and date link to the full post.
 */
import CardViewer from './CardViewer.astro';
import { fmt, formatDate, strings } from '../i18n';
import { inlineCards, inlineUid } from '../lib/cards';
import type { PostSummary } from '../lib/cms-types';
import type { Locale } from '../lib/locale';
import PostKindSummary from './posts/PostKindSummary.astro';

/** `byline: false` on a scholar's own page (every post there is theirs). */
interface Props { locale: Locale; posts: PostSummary[]; headingLevel?: 2 | 3; cmsOrigin: string; byline?: boolean }
const { locale, posts, headingLevel = 2, cmsOrigin, byline = true } = Astro.props;
const t = strings(locale);
const H = `h${headingLevel}`;
// The first card post near the top carries the list's first image: the LCP candidate (eager).
const lcp = posts.findIndex((p) => inlineCards(p));
const href = (p: PostSummary) => `/${locale}/articles/${encodeURIComponent(p.slug)}/`;
---
<ul class="articles-list">
  {posts.map((p, i) => {
    const cards = inlineCards(p);
    return (
      <li class:list={['articles-item', cards && 'articles-item-cards']}>
        <time datetime={p.published_at}>{formatDate(p.published_at, locale)}</time>
        <H><a href={href(p)}>{p.title}</a></H>
        {byline && p.author && (
          <p class="articles-by"><a href={`/${locale}/scholars/${encodeURIComponent(p.author.slug)}/`}>{fmt(t.scholars.byScholar, { name: p.author.name })}</a></p>
        )}
        {cards ? (
          <CardViewer
            slides={cards.slides}
            title={p.title}
            contentLocale={p.locale}
            locale={locale}
            cmsOrigin={cmsOrigin}
            inline={{ href: href(p), uid: inlineUid(), total: cards.total, more: cards.more, priority: i === lcp && i < 3, size: 'list' }}
          />
        ) : (
          p.excerpt && <p>{p.excerpt}</p>
        )}
        <PostKindSummary post={p} locale={locale} cmsOrigin={cmsOrigin} />
      </li>
    );
  })}
</ul>
