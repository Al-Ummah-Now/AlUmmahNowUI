---
/**
 * www's error pages (404, 500, a page the CMS can't serve right now): the Al Ummah Now error card
 * (packages/render/src/error-page.ts, wiki guides/error-pages.md), the same card, words and actions
 * as every other app, on the lantern street inside the site's header and footer.
 */
import '../../../../packages/render/src/styles/aun-error-page.css';
import { errorCardHtml, ERROR_CARD_STRINGS, type ErrorCardKind } from '../../../../packages/render/src/error-page';
import type { Locale } from '../lib/locale';

interface Props { locale: Locale; kind: 'not_found' | 'server' | 'unavailable' }
const { locale, kind } = Astro.props;
const card: ErrorCardKind = kind === 'not_found' ? 'notFound' : kind;
const t = ERROR_CARD_STRINGS[locale];
const home = { label: t.goHome, href: `/${locale}/`, icon: 'home' as const };
const html = errorCardHtml({
  locale,
  kind: card,
  // Gold for the card's one main action, as on every app's error page; the rest outlined
  buttonClass: { primary: 'button button-primary', secondary: 'button button-outline' },
  // 404: the site search and the way home; 500/503: try the same page again, or home
  primary: card === 'notFound' ? home : { label: t.tryAgain, href: Astro.url.pathname, icon: 'retry' },
  secondary: card === 'notFound' ? [] : [home],
  search: card === 'notFound' ? { action: `/${locale}/search` } : undefined,
  back: true,
  contactHref: `/${locale}/contact`,
});
---
<Fragment set:html={html} />
<script is:inline src="/ep-back.js" defer></script>
