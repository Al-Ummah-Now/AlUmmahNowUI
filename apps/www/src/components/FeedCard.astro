---
/**
 * One home timeline item (src/lib/feed.ts FeedItem): a post (cover, card face or its videos;
 * title, excerpt, author, time) or a video entry. Videos are facades: poster + play button; the
 * player iframe loads only on a click (src/scripts/facade.ts).
 *
 * Card posts show every card inline (CardViewer `inline`): the feed carries a card post's first 10
 * slides (docs/CMS_PUBLIC_API.md "Card posts"); a longer post ends with a "See all N cards" link.
 * A feed built before the CMS sent `slides` gives the first card only, with that link.
 *
 * A channel entry (docs/specs/WWW-PAGES.md D7) is its own card: avatar, name and @handle, its
 * newest ≤ 3 videos as small linked thumbnails, and "Visit channel".
 */
import CardViewer from './CardViewer.astro';
import { fmt, strings } from '../i18n';
import { inlineCards, inlineUid } from '../lib/cards';
import { watchUrl } from '../lib/embeds';
import { facadeHtml, frameShape } from '../lib/facade';
import type { FeedItem } from '../lib/feed';
import { relativeTime } from '../lib/feed';
import { dir, type Locale } from '../lib/locale';
import { pictureHtml } from '../lib/picture';
import { absoluteTime, channelCard, feedVideoItem, isShort } from '../lib/timeline';
import Icon from './Icon.astro';
import PostKindSummary from './posts/PostKindSummary.astro';

/** `titleLevel`: the card title's heading level (4 under the home's h2/h3 days; 3 on a list page). */
interface Props { item: FeedItem; locale: Locale; cmsOrigin: string; videosWebUrl: string; priority: boolean; now: Date; titleLevel?: 3 | 4 }
const { item, locale, cmsOrigin, videosWebUrl, priority, now, titleLevel = 4 } = Astro.props;
const H = `h${titleLevel}` as 'h3' | 'h4';
const t = strings(locale);
const tl = t.timeline;
const id = `tl-${item.key}`;
const COVER_SIZES = '(min-width: 44rem) 40rem, calc(100vw - 2rem)';

const post = item.type === 'post' ? item.post! : null;
const contentLocale: Locale = post?.locale === 'ar' || post?.locale === 'en' ? post.locale : locale;
const href = post ? `/${locale}/articles/${encodeURIComponent(post.slug)}/` : null;
const cards = post ? inlineCards(post) : null;
const videos = post ? post.videos.filter((v) => v.kind === 'video' || v.kind === 'playlist') : [];

const isChannel = item.type === 'video' && item.video?.kind === 'channel';
const channel = isChannel ? channelCard(item.video!, locale, videosWebUrl, tl.channel, now.getTime()) : null;
const videoEntry = item.type === 'video' && item.video && !isChannel ? feedVideoItem(item.video, locale, tl.video, now.getTime(), videosWebUrl) : null;
const title = post ? post.title : (videoEntry?.title ?? '');

// Media: a post's videos replace its cover (they are its media); a card post shows its first card.
const facades = videos.map((v, i) => {
  const video = feedVideoItem(v, locale, tl.video, now.getTime(), videosWebUrl);
  return facadeHtml(video, { videosWebUrl, lang: locale, caption: false, className: i === 0 ? 'tl-facade' : 'tl-facade tl-facade-sm' });
});
const coverHtml = post && !cards && !videos.length && post.cover ? pictureHtml(post.cover, cmsOrigin, { sizes: COVER_SIZES, priority, className: 'tl-cover' }) : null;
const entryHtml = videoEntry ? facadeHtml(videoEntry, { videosWebUrl, lang: locale, caption: false, className: 'tl-facade' }) : null;
const watch = videoEntry && videoEntry.kind !== 'channel' ? watchUrl(videosWebUrl, { kind: videoEntry.kind, id: videoEntry.id, lang: locale }) : null;

// Card posts and videos are the media alone (no box): title, channel or author and time sit over it,
// shown on hover, focus or a tap. Articles read as text: byline (avatar, name, time), cover, title, excerpt.
const mediaFirst = !!(cards && href) || !!entryHtml || facades.length > 0;
const firstVideo = videoEntry ?? (videos[0] ? feedVideoItem(videos[0], locale, tl.video, now.getTime(), videosWebUrl) : null);
const shape = facades.length > 1 ? 'ar-16x9' : frameShape(firstVideo?.width, firstVideo?.height);
const channelName = videoEntry?.channelName ?? null;
// One video in the post: hover preview (muted, with play/sound/progress) and, for a Short, the Shorts viewer
const previewable = facades.length <= 1 && !!firstVideo && firstVideo.kind === 'video';
const short = previewable && isShort(shape, firstVideo?.durationSeconds);
const author = post?.author ?? null;
const avatarHtml = author?.avatar ? pictureHtml(author.avatar, cmsOrigin, { sizes: '2rem', priority: false, className: 'tl-avatar' }) : null;
const byHref = author ? `/${locale}/scholars/${encodeURIComponent(author.slug)}/` : null;
const siteName = t.meta.siteName;
---
{channel ? (
<li class="tl-item" data-date={item.date} data-key={item.key}>
  <article class:list={['tl-card', 'tl-channel', item.pinned && 'tl-card-pinned']} aria-labelledby={id}>
    <div class="tl-channel-head">
      {channel.avatarUrl ? (
        <img class="tl-channel-avatar" src={channel.avatarUrl} alt="" width="64" height="64" loading="lazy" decoding="async" />
      ) : (
        <span class="tl-channel-avatar" aria-hidden="true" />
      )}
      <div class="tl-channel-name">
        <H class="tl-title" id={id} dir="auto"><a href={channel.href}>{channel.name}</a></H>
        {channel.handle && <p class="tl-excerpt"><bdi dir="ltr">@{channel.handle}</bdi></p>}
      </div>
    </div>
    {channel.latest.length > 0 && (
      <ul class="tl-channel-latest" aria-label={fmt(tl.channelLatest, { name: channel.name })}>
        {channel.latest.map((v) => (
          <li>
            <a href={v.href}>
              <span class="tl-channel-thumb">
                {v.thumbnailUrl ? <img src={v.thumbnailUrl} alt="" width="320" height="180" loading="lazy" decoding="async" /> : null}
                {v.duration && <span class="tl-channel-dur" dir="ltr">{v.duration}</span>}
              </span>
              <span class="tl-channel-vtitle" dir="auto">{v.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <div class="tl-body">
      <p class="tl-meta">
        <span class="tl-kind">{tl.channel}</span>
        <time datetime={item.date} data-rel title={absoluteTime(item.date, locale)}>{relativeTime(item.date, now, locale)}</time>
        <span class="tl-abs" data-abs>{absoluteTime(item.date, locale)}</span>
      </p>
      <p class="tl-channel-visit"><a class="button button-quiet" href={channel.href}>{tl.visitChannel}</a></p>
    </div>
  </article>
</li>
) : !isChannel && (
<li class="tl-item" data-date={item.date} data-key={item.key}>
  <article class:list={['tl-card', mediaFirst && 'tl-bare', item.pinned && 'tl-card-pinned']} aria-labelledby={id}>
    {cards && href ? (
      <CardViewer
        slides={cards.slides}
        title={title}
        contentLocale={contentLocale}
        locale={locale}
        cmsOrigin={cmsOrigin}
        inline={{ href, uid: inlineUid(), total: cards.total, more: cards.more, priority, size: 'timeline' }}
      >
        <div slot="overlay" class="tl-ov">
          <H class="tl-title" id={id} lang={contentLocale} dir={dir(contentLocale)}><a href={href}>{title}</a></H>
          <p class="tl-meta">
            {post?.author_name && <span class="tl-author">{post.author_name}</span>}
            <time datetime={item.date} data-rel title={absoluteTime(item.date, locale)}>{relativeTime(item.date, now, locale)}</time>
            <span class="visually-hidden" data-abs>{absoluteTime(item.date, locale)}</span>
          </p>
        </div>
      </CardViewer>
    ) : mediaFirst ? (
      <div class:list={['tl-mwrap', `tl-${shape}`]} data-video-id={previewable ? firstVideo!.id : undefined} data-short={short ? '' : undefined}>
        {entryHtml && <Fragment set:html={entryHtml} />}
        {facades.length > 0 && (
          <div class:list={['tl-videos', facades.length > 1 && 'tl-videos-many']}>
            {facades.map((html) => <Fragment set:html={html} />)}
          </div>
        )}
        <div class="tl-ov">
          <H class="tl-title" id={id} lang={contentLocale} dir={dir(contentLocale)}>
            {href ? <a href={href}>{title}</a> : watch ? <a href={watch}>{title}</a> : title}
          </H>
          <p class="tl-meta">
            {channelName && <span class="tl-author" dir="auto">{channelName}</span>}
            {!channelName && post?.author_name && <span class="tl-author">{post.author_name}</span>}
            <time datetime={item.date} data-rel title={absoluteTime(item.date, locale)}>{relativeTime(item.date, now, locale)}</time>
            <span class="visually-hidden" data-abs>{absoluteTime(item.date, locale)}</span>
          </p>
          {post?.excerpt && <p class="visually-hidden" lang={contentLocale}>{post.excerpt}</p>}
        </div>
        {previewable && (
          <div class="tl-vctl" data-vctl hidden>
            <button type="button" class="tl-vbtn" data-vplay aria-label={tl.previewPause}><Icon name="pause" /></button>
            <button type="button" class="tl-vbtn tl-vmute" data-vmute aria-pressed="false" aria-label={tl.unmute}><Icon name="sound-off" /><span>{tl.soundOff}</span></button>
            <span class="tl-vprog" aria-hidden="true"><i data-vprog></i></span>
          </div>
        )}
      </div>
    ) : (
      <>
        <p class="tl-byline">
          {avatarHtml ? <Fragment set:html={avatarHtml} /> : <img class="tl-avatar" src="/brand/logo-192.webp" alt="" width="32" height="32" loading="lazy" decoding="async" />}
          <span class="tl-author">{byHref ? <a href={byHref}>{post?.author_name}</a> : (post?.author_name ?? siteName)}</span>
          <time datetime={item.date} data-rel title={absoluteTime(item.date, locale)}>{relativeTime(item.date, now, locale)}</time>
          <span class="visually-hidden" data-abs>{absoluteTime(item.date, locale)}</span>
        </p>
        {coverHtml && href && (
          <a class="tl-media" href={href} tabindex="-1" aria-hidden="true"><Fragment set:html={coverHtml} /></a>
        )}
        <div class="tl-body">
          <H class="tl-title" id={id} lang={contentLocale} dir={dir(contentLocale)}>
            {href ? <a href={href}>{title}</a> : title}
          </H>
          {post?.excerpt && <p class="tl-excerpt" lang={contentLocale} dir={dir(contentLocale)}>{post.excerpt}</p>}
          {post && <PostKindSummary post={post} locale={locale} cmsOrigin={cmsOrigin} images={false} />}
        </div>
      </>
    )}
  </article>
</li>
)}
