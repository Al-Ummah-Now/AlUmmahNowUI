---
/**
 * What a list shows for a scholar post of a community kind (AlUmmahNowCMS docs/SCHOLARS.md §7), from
 * the summary the CMS caches (PostSummary `v2`): a poll's or quiz's choices (voting happens on the
 * channel), a link's preview card, an image post's pictures, a video's "Watch". Articles and cards keep their
 * own list rendering. Text is text, never HTML.
 */
import { fill as fmt, postStrings } from './strings';
import type { PostSummaryLike } from './types';
import { normalizeImageUrl } from '../images';
import { dir, type Locale } from '../locale';
import { isArticleKind } from './post-kinds';
import PostLinkCard from './PostLinkCard.astro';

/** `images: false` where the list already shows the post's cover (the home timeline). */
interface Props { post: PostSummaryLike; locale: Locale; cmsOrigin: string; images?: boolean }
const { post, locale, cmsOrigin, images: withImages = true } = Astro.props;
const t = postStrings(locale);
const v2 = post.v2 ?? null;
const kind = post.kind ?? 'article';
const show = !!v2 && !isArticleKind(kind);
const images = (v2?.images ?? []).map((m) => ({ url: normalizeImageUrl(m.url, [cmsOrigin]), alt: m.alt ?? '' })).filter((m): m is { url: string; alt: string } => !!m.url);
const choices = kind === 'poll' ? v2?.poll : kind === 'quiz' ? v2?.quiz : null;
const more = v2 ? v2.image_count - images.length : 0;
---
{show && (
  <div class="post-kind-summary" lang={post.locale} dir={dir(post.locale)} data-post-kind={kind}>
    {withImages && kind === 'image' && images.length > 0 && (
      <ul class:list={['post-kind-images', images.length > 1 && 'post-kind-images-many']}>
        {images.map((m) => <li><img src={m.url} alt={m.alt} loading="lazy" decoding="async" /></li>)}
        {more > 0 && <li class="post-kind-more">{fmt(t.moreImages, { count: more })}</li>}
      </ul>
    )}
    {choices && choices.options.length > 0 && (
      <ul class="post-kind-options" aria-label={kind === 'poll' ? t.pollOptions : t.quizOptions}>
        {choices.options.slice(0, 5).map((o) => <li>{o.text}</li>)}
      </ul>
    )}
    {kind === 'link' && v2?.link && <PostLinkCard link={{ ...v2.link, siteName: v2.link.site_name ?? null }} locale={locale} extra={[cmsOrigin]} compact images={withImages} />}
    {post.ref && (kind === 'poll' || kind === 'quiz') && (
      <p class="post-kind-action"><a href={post.ref.videos_url}>{kind === 'poll' ? t.voteOnChannel : t.answerOnChannel}</a></p>
    )}
  </div>
)}
