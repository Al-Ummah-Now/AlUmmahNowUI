---
/**
 * A scholar post's likes and comments live on its community post (AlUmmahNowCMS docs/SCHOLARS.md §7):
 * the counts, and "Join the discussion" on the channel. Inline engagement comes later (AUN-SCHOLAR-SITES
 * phase 4).
 */
import { fill as fmt, postStrings } from './strings';
import type { PostRef } from './types';
import type { Locale } from '../locale';

interface Props { postRef: PostRef; locale: Locale; likes?: number | null; comments?: number | null; commentsEnabled?: boolean }
const { postRef, locale, likes = null, comments = null, commentsEnabled = true } = Astro.props;
const t = postStrings(locale);
const count = (n: number | null, one: string, many: string) => (n === null ? null : n === 1 ? one : fmt(many, { count: n.toLocaleString(locale === 'ar' ? 'ar-EG' : 'en') }));
const likeText = count(typeof likes === 'number' ? likes : null, t.oneLike, t.likes);
const commentText = commentsEnabled ? count(typeof comments === 'number' ? comments : null, t.oneComment, t.comments) : null;
---
<aside class="post-engagement" aria-label={t.engagement} data-post-engagement={postRef.post_id}>
  {(likeText || commentText) && (
    <p class="post-engagement-counts">
      {likeText && <span>{likeText}</span>}
      {commentText && <span>{commentText}</span>}
    </p>
  )}
  <a class="button button-quiet" href={postRef.videos_url}>{t.joinDiscussion}</a>
</aside>
